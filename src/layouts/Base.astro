---
import '../styles/global.css';
// Where each hero image is anchored when it is cropped. focal.css is
// generated by scripts/focal-points.py; the overrides file is hand-written
// and loaded after it, so a corrected anchor survives regeneration.
import '../styles/focal.css';
import '../styles/focal-overrides.css';
import Nav from '../components/Nav.astro';
import Foot from '../components/Foot.astro';
import Lightbox from '../components/Lightbox.astro';
import Portal from '../components/Portal.astro';
import { site } from '../data/site.js';
import { SITE_URL } from '../data/domain.js';

const {
  title,
  description = site.bioShort,
  current = '',
  palette = '',
  hasHero = false,
  bodyClass = 'paper',
  image,
  schema,            // an extra schema.org record for this page (an Article, say)
  brief = false,     // offer the "Less text" button: headings, pictures, films and links only
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · artist & art historian, murals, ceramics and AI`;

const ogImage = new URL(image ?? '/images/og-card.jpg', SITE_URL).href;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;

// Told to search engines rather than inferred by them: who this is, what she
// does, and the other places on the web that are the same person. `sameAs` is
// what lets Google connect the profiles up instead of guessing.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Vanessa Rosa',
  alternateName: 'va2rosa',
  url: SITE_URL,
  image: new URL('/images/me/me-03.webp', SITE_URL).href,
  jobTitle: 'Visual artist and art historian working with AI',
  description: site.bioShort,
  email: `mailto:${site.email}`,
  nationality: { '@type': 'Country', name: 'Brazil' },
  knowsAbout: [
    'Contemporary art', 'Art history', 'Artificial intelligence art', 'AI art',
    'Generative AI', 'Training custom AI models on an artist’s own work',
    'AI and authorship', 'AI education for artists', 'AI filmmaking',
    'Ethnomathematics', 'Ceramics', 'Mural painting', 'Public art',
    'Generative art', 'Projection mapping',
  ],
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'ORCID',
    value: site.orcid,
  },
  sameAs: [
    site.instagram,
    site.orcid,
    site.littleMartians,
    'https://littlemartians.substack.com/',
    'https://va2rosa.medium.com/',
    'https://www.nvidia.com/en-us/research/ai-art-gallery/artists/vanessa-rosa/',
    'https://onlineonly.christies.com/s/augmented-intelligence/vanessa-rosa-b-1990-31/250113',
  ].filter(Boolean),
};

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: SITE_URL,
  inLanguage: 'en',
  author: { '@type': 'Person', name: 'Vanessa Rosa' },
};
---

<!doctype html>
<html lang="en" data-palette={palette || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="author" content={site.name} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="llms-full.txt" />
    <!-- For agents: the machine-readable versions of this site (the footer links
         to /for-ai too, so crawlers find it). -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <link rel="alternate" type="text/markdown" href="/for-ai.txt" title="For AI agents" />
    <link rel="alternate" type="application/json" href="/for-ai.json" title="For AI agents, JSON" />
    <link rel="preload" href="/fonts/verdelis-latin.woff2" as="font" type="font/woff2" crossorigin />
    {brief && (
      <script is:inline>
        // Remembered from the last visit, and set before anything is drawn so
        // the long text never flashes up first.
        try { if (localStorage.getItem('brief') === '1') document.documentElement.classList.add('brief'); } catch (e) {}
      </script>
    )}
  </head>

  <body class={hasHero ? 'hashero' : undefined}>
    <Nav current={current} />
    <div class={bodyClass}>
      <slot />
      <Foot />
    </div>
    <Lightbox />
    <Portal />
    {brief && (
      <>
        <button class="brief-btn" type="button" aria-pressed="false">Less text</button>
        <script is:inline>
          // One button: the long text folds away, leaving the headings, the
          // pictures, the films and the links. Pressed again, it all comes back.
          (function () {
            var b = document.querySelector('.brief-btn');
            var root = document.documentElement;
            function sync() {
              var on = root.classList.contains('brief');
              b.setAttribute('aria-pressed', String(on));
              b.textContent = on ? 'All text' : 'Less text';
            }
            b.addEventListener('click', function () {
              var on = root.classList.toggle('brief');
              try { localStorage.setItem('brief', on ? '1' : '0'); } catch (e) {}
              sync();
            });
            sync();
          })();
        </script>
      </>
    )}
    <script is:inline>
      // The bar is fixed, and on a narrow screen it wraps to more than one
      // row. Publish its real height so a page without a hero starts under it
      // instead of behind it.
      (function () {
        var nav = document.querySelector('.nav');
        if (!nav) return;
        var set = function () {
          document.documentElement.style.setProperty('--navh', nav.offsetHeight + 'px');
        };
        set();
        addEventListener('resize', set, { passive: true });
        addEventListener('orientationchange', set);
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(set);
      })();
    </script>
  </body>
</html>
