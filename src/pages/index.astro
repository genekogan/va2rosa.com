---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import SpaceTime from '../components/SpaceTime.astro';
import { site } from '../data/site.js';
import { heroLoop, HOLD } from '../data/heroloop.js';
import { collections, essays } from '../data/collections.js';
import fs from 'node:fs';
import { topics } from '../data/topics.js';
import { nowRows } from '../data/cv.js';
import { press } from '../data/misc.js';

const livePress = press.filter((p) => p.live);

// a figure is only drawn if its file is actually on disk, so a picture still
// stuck in Drive cannot leave a broken image on the homepage
const figs = essays.research.figures.filter((f) =>
  fs.existsSync(new URL('../../public' + f.src, import.meta.url))
);
---

<Base
  bodyClass=""
  hasHero={true}
  description="Vanessa Rosa is a Brazilian time traveling artist. Murals become portals with projection mapping; hand-built ceramics become AI-powered characters. Little Martians, Mars College, and twenty years of public art, films and books."
>
  <!-- ENTRY ------------------------------------------------------------- -->
  <header class="hero" data-hold={HOLD}>
    <div class="hs">
      {heroLoop.map((f, i) => (
        <div class={`hs-slide mv-${f.move}${i === 0 ? ' is-on' : ''}`} data-i={i}>
          <img
            class="bg"
            src={i === 0 ? f.src : undefined}
            data-src={i === 0 ? undefined : f.src}
            alt={i === 0 ? f.alt : ''}
            style={`object-position:${f.pos}`}
            fetchpriority={i === 0 ? 'high' : undefined}
            aria-hidden={i === 0 ? undefined : 'true'}
            data-nozoom
          />
        </div>
      ))}
    </div>
    <div class="veil"></div>

    <div class="scrollcue" aria-hidden="true">Scroll ↓</div>
  </header>

  <div class="paper">

    <!-- THE FIRST SCREEN, AND THE WAY THROUGH IT ------------------------------
         "dear human" and the timeline hold still together. Space starts to
         bend under them: a fine grid appears, a shape rises from the bottom
         of the page and pushes it out of the way, the page ripples, and the
         first Little Martian comes up through it until the desert takes its
         place. Then the page scrolls on. ------------------------------------ -->
    <section class="tlp" id="door" data-scrolly="portal">
      <div class="tlp-stage">
        <div class="tlp-content">
          <!-- WHO ------------------------------------------------------------- -->
          <section class="wrap intro" id="intro">
            <p class="greeting">{site.greeting}</p>
            <h1
              class="sec welcome"
              set:html={site.statementTitle
                .replace('\n', '<br>')
                .replace('time traveling', '<span class="tt">time traveling</span>')}
            />
            <p class="intro-what">
              {site.statement.map((line, i) => (<>{i > 0 && <>{' '}<br /></>}{line}</>))}
            </p>
          </section>
          <section class="wrap" style="padding-top:44px" id="timeline">
            <Timeline />
          </section>
          <!-- phones only: the timeline as threads in a gravity well -->
          <section class="wrap st-wrap">
            <SpaceTime />
          </section>
        </div>

        <svg class="fx-defs" aria-hidden="true" width="0" height="0">
          <filter id="tl-warp" x="-5%" y="-5%" width="110%" height="110%">
            <feTurbulence type="fractalNoise" baseFrequency="0.004 0.009" numOctaves="2" seed="7" result="n" />
            <feDisplacementMap in="SourceGraphic" in2="n" scale="0" xChannelSelector="R" yChannelSelector="G" />
          </filter>
          <filter id="pencil-edge" x="-10%" y="-25%" width="120%" height="150%">
            <feTurbulence type="fractalNoise" baseFrequency="0.035 0.06" numOctaves="2" seed="11" result="w" />
            <feDisplacementMap in="SourceGraphic" in2="w" scale="3.2" xChannelSelector="R" yChannelSelector="G" result="bent" />
            <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="1" seed="5" result="g" />
            <feDisplacementMap in="bent" in2="g" scale="1.2" xChannelSelector="R" yChannelSelector="G" />
          </filter>
          <filter id="pencil" x="-20%" y="-2%" width="140%" height="104%">
            <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" seed="3" result="g" />
            <feDisplacementMap in="SourceGraphic" in2="g" scale="1.6" xChannelSelector="R" yChannelSelector="G" />
          </filter>
        </svg>
        <div class="tlp-portal">
          <canvas class="portal-grid" aria-hidden="true"></canvas>
          <div class="portal-win">
            <img src="/images/home/door-martians.webp" alt="The first Little Martian: a ceramic head lying on cracked desert ground." loading="lazy" data-full data-nozoom />
          </div>
          <div class="portal-veil"></div>
          <div class="portal-t">
            <div class="wrap">
              <h2 class="portal-logo"><img src="/images/home/lm-logo-white.webp" alt="Little Martians" loading="lazy" data-nozoom /></h2>
              <p>
                Imagining the future with my hands. I create a sci-fi world based on my ceramic
                characters. They’re Little Martians: a species descended from all of Earth’s life,
                tending life in extreme worlds and keeping our memory in the Imaginarium.
              </p>
              <p class="door-links">
                <a class="more" href="/threads/little-martians">The thread on this site ⇢</a>
                <a class="more" href={site.littleMartians} rel="noopener" target="_blank">Enter littlemartians.world ⇢</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- RESEARCH -------------------------------------------------------- -->
    <section class="wrap essay res-block" id="research-note">
      {figs[0] && (
        <img class="res-fig left" src={figs[0].src} alt={figs[0].alt} loading="lazy" />
      )}

      <div class="res-mid">
        <div class="kicker">{essays.research.kicker}</div>
        <p class="res-ask">{essays.research.highlight}</p>
        <div class="res-note">
          {essays.research.body.map((p) => <p>{p}</p>)}
        </div>
        {/* the names only; the one link below carries everyone through */}
        <p class="res-topics">
          {topics.map((t, i) => (
            <>
              {i > 0 && <span class="sep">·</span>}
              <span>{t.title}</span>
            </>
          ))}
        </p>
        <a class="more" style="margin-top:22px" href={essays.research.href}>{essays.research.linkText}</a>
      </div>

      {figs[1] && (
        <img class="res-fig right" src={figs[1].src} alt={figs[1].alt} loading="lazy" />
      )}
    </section>

    <!-- BODIES OF WORK: one path through time, each body of work a stop on
         it; the line draws itself as you go ------------------------------ -->
    <section class="wrap bw" id="work">
      <div class="kicker">The art</div>
      <h2 class="sec" style="margin:12px 0 10px">Many bodies of work</h2>
      <p class="bw-lede">
        Grouped by what they are made of and what they are for. They overlap, and each one fed
        the next.
      </p>

      <ol class="bw-list" data-scrolly="braid">
        <svg class="bw-braid" aria-hidden="true"><g class="bw-lines"><path /><path /><path /><path /><path /><path /></g><g class="bw-stops"></g></svg>
        {collections.map((c, i) => (
          <li class="bw-item" data-scrolly="reveal">
            <a class="bw-img" href={c.items[0].href} tabindex="-1" aria-hidden="true">
              <img src={c.image} alt="" loading="lazy" data-nozoom />
            </a>
            <div class="bw-text">
              <span class="bw-n">{String(i + 1).padStart(2, '0')} · {c.span}</span>
              <h3>{c.title}</h3>
              <p>{c.blurb}</p>
              <ul class="bw-links">
                {c.items.map((it) => (
                  <li>
                    <a
                      href={it.href}
                      target={it.external ? '_blank' : undefined}
                      rel={it.external ? 'noopener' : undefined}
                    >
                      {it.label}<span>{it.years}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- IN PRINT (hidden until real quotes exist) ------------------------ -->
    {livePress.length > 0 && (
      <section class="wrap essay" id="press">
        <div class="kicker">In print</div>
        {livePress.map((q) => (
          <blockquote style="margin-top:26px; max-width:34em">
            <p class="hand" style="font-size:24px; line-height:1.3">“{q.quote}”</p>
            <cite class="kicker" style="font-style:normal">{q.outlet}, {q.year}</cite>
          </blockquote>
        ))}
      </section>
    )}

    <!-- MARS COLLEGE: the whole building as it comes up the page, the walk to the
         flower above the doors happening while it does -------------------- -->
    <section class="mars-j" id="mars" data-scrolly="mars" data-a="2926 3650 0.53 0.266 0.145">
      <div class="mars-stage">
        <img class="mars-a" src="/images/home/mars-approach-2.webp" alt="Chiba, the red mural building at Mars College, 2024, with the Mars College flower painted above the doors." loading="lazy" data-full data-nozoom />
        <div class="mars-t">
          <div class="wrap">
            <div class="kicker">The desert</div>
            <h2>Mars College</h2>
            <p>
              Mars College is an annual off-grid pop-up college built literally from the ground up
              every winter in the California desert.
            </p>
            <p class="door-links">
              <a class="more" href="/mars-college">My thread on Mars College ⇢</a>
              <a class="more" href="https://mars.college" rel="noopener" target="_blank">mars.college ⇢</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- NOW ------------------------------------------------------------- -->
    <section class="wrap essay" id="now">
      <div class="kicker">Current &amp; forthcoming</div>
      <h2 class="sec" style="margin:12px 0 0">Current &amp; Forthcoming</h2>
      <ul class="rows">
        {nowRows.map((r) => (
          <li>
            <span>{r.year}{r.monthLabel ? ` · ${r.monthLabel}` : ''}</span>
            <div>
              {r.href ? (
                <a
                  class="pr-t"
                  href={r.href}
                  target={r.href.startsWith('http') ? '_blank' : undefined}
                  rel={r.href.startsWith('http') ? 'noopener' : undefined}
                >
                  {r.title}
                </a>
              ) : (
                r.title
              )}
              {r.venue && <span style="opacity:.7">, {r.venue}</span>}
              {r.city && <span style="opacity:.7">, {r.city}</span>}
            </div>
          </li>
        ))}
      </ul>
      <p style="margin-top:34px"><a class="more" href="/info">Full record ⇢</a></p>
    </section>

    <!-- SUBSCRIBE: an email field that hands the address to the newsletter's own
         sign-up page, already filled in, where the reader confirms. Nothing
         from Substack loads on this site. -->
    <section class="wrap subscribe" id="subscribe">
      <div class="kicker">Little Martians World, on Substack</div>
      <p class="sub-t">Follow the research by email.</p>
      <form class="sub-form" action="https://littlemartians.substack.com/subscribe" method="get" target="_blank" rel="noopener">
        <input type="email" name="email" required placeholder="Your email" autocomplete="email" aria-label="Your email" />
        <button type="submit" class="sub-btn">Subscribe</button>
      </form>
      <p class="sub-note">You confirm on Substack, in one click.</p>
    </section>

    <!-- the end: seeds and plants from Verdelis’s Letter, growing up from
         the bottom of the page as you arrive -->
    <div class="garden" aria-hidden="true" data-scrolly="reveal" data-wait>
      <img class="g g1" src="/images/home/garden-plants1.webp" alt="" loading="lazy" data-nozoom />
      <img class="g g2" src="/images/home/garden-seed2.webp" alt="" loading="lazy" data-nozoom />
      <img class="g g3" src="/images/home/garden-seed5.webp" alt="" loading="lazy" data-nozoom />
      <img class="g g4" src="/images/home/garden-flor2.webp" alt="" loading="lazy" data-nozoom />
      <img class="g g5" src="/images/home/garden-seed4.webp" alt="" loading="lazy" data-nozoom />
    </div>









  </div>

  <script is:inline>
  // Scroll-driven sections. Each gets --p, how far the reader has come
  // through it (0 → 1); the CSS reads it for fades and focus. Three drawings
  // read it here, all in the same quiet line as the Temporal Art Show pages:
  //   portal — the timeline holds still; a fine grid of space gathers toward
  //            one point, the timeline is drawn into it, and the first Little
  //            Martian grows through the opening until the desert fills the page;
  //   braid  — three thin timelines braided down the bodies of work, meeting
  //            at each one, drawn as you read;
  //   mars   — the whole building, then one straight walk up to the flower.
  // Reduced motion: each is drawn once, finished, and stays still.
  (function () {
    var secs = [].slice.call(document.querySelectorAll('[data-scrolly]'));
    if (!secs.length) return;
    var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var cl = function (x) { return x < 0 ? 0 : x > 1 ? 1 : x; };
    var ease = function (x) { x = cl(x); return x * x * (3 - 2 * x); };
    var lerp = function (a, b, t) { return a + (b - a) * t; };
    var BLUE = '28, 74, 134', GOLD = '170, 132, 52';

    function progress(sec, r, vh) {
      var t = sec.dataset.scrolly;
      if (t === 'reveal') {
        // a group that grows together waits until every picture in it has arrived
        if (sec.hasAttribute('data-wait') && [].some.call(sec.querySelectorAll('img'), function (im) { return !im.complete; })) return 0;
        return cl((vh - r.top) / (vh * 0.55));
      }
      if (t === 'braid') return cl((vh * 0.7 - r.top) / r.height);
      if (t === 'portal') {
        // the stage is pinned while the section passes; p runs over that hold
        var st = sec.firstElementChild, sh = st.offsetHeight, top = Math.min(0, vh - sh);
        if (sec.dataset.sh !== String(sh)) { sec.dataset.sh = sh; sec.style.setProperty('--stage-h', sh + 'px'); }
        st.style.top = top + 'px';
        return cl((top - r.top) / (r.height - st.offsetHeight));
      }
      // mars: from its top edge appearing to its bottom edge reaching the
      // bottom of the screen
      return cl((vh - r.top) / r.height);
    }

    var draw = {
      portal: function (sec, p) {
        var layer = sec.querySelector('.tlp-portal'), cv = layer.querySelector('canvas');
        var win = layer.querySelector('.portal-win'), img = win.querySelector('img');
        var content = sec.querySelector('.tlp-content');
        var moving = document.documentElement.classList.contains('scrolly');
        var W = layer.clientWidth, H = layer.clientHeight;
        var dpr = Math.min(devicePixelRatio || 1, 2);
        if (cv.width !== Math.round(W * dpr) || cv.height !== Math.round(H * dpr)) {
          cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
        }
        var ctx = cv.getContext('2d');
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, W, H);

        var open = 0.8, t = cl(p / open);
        // the shape: it rises from the bottom of the page, grows, and keeps
        // changing its outline as it comes (slow waves of different lengths)
        var R = lerp(Math.min(W, H) * 0.05, Math.hypot(W, H) * 0.78, Math.pow(t, 1.45));
        var cx = W * 0.5 + Math.sin(p * 5.3) * W * 0.025;
        var cy = lerp(H * 1.08, H * 0.52, ease(t * 1.15));
        var wob = 0.3 * Math.pow(1 - t, 0.6);
        var rise = 0.28 * Math.pow(1 - t, 0.8);       // taller at the top while it is pushing up
        var edge = function (a) {
          return 1 - rise * Math.sin(a) +
            wob * (0.45 * Math.sin(2 * a + p * 3.1) + 0.3 * Math.sin(3 * a - p * 4.3 + 1) + 0.15 * Math.sin(5 * a + p * 6.7 + 2) + 0.1 * Math.sin(7 * a - p * 2.3));
        };

        // the page itself bends while the shape comes up
        if (moving) {
          var fe = sec.ownerDocument.querySelector('#tl-warp feDisplacementMap');
          var ft = sec.ownerDocument.querySelector('#tl-warp feTurbulence');
          var bend = W > 760 ? 30 * ease(p / 0.55) * (1 - ease((p - 0.65) / 0.15)) : 0;
          if (bend > 0.5) {
            fe.setAttribute('scale', bend.toFixed(1));
            ft.setAttribute('baseFrequency', (0.004 + 0.002 * p).toFixed(4) + ' ' + (0.009 + 0.004 * p).toFixed(4));
            content.style.filter = 'url(#tl-warp)';
          } else content.style.filter = 'none';
          content.style.opacity = (1 - 0.55 * ease((p - 0.15) / 0.5)).toFixed(3);
        }

        // the shape's outline
        var pts3 = [];
        for (var k = 0; k < 120; k++) {
          var a = (k / 120) * Math.PI * 2, rr = R * edge(a);
          pts3.push([cx + Math.cos(a) * rr, cy + Math.sin(a) * rr]);
        }

        // the grid: the page's surface, pushed outwards around the shape, as
        // if stretched over it (never drawn over the shape itself)
        ctx.save();
        ctx.beginPath(); ctx.rect(0, 0, W, H);
        pts3.forEach(function (q, n) { n ? ctx.lineTo(q[0], q[1]) : ctx.moveTo(q[0], q[1]); });
        ctx.closePath(); ctx.clip('evenodd');
        var alpha = ease(p / 0.14) * (1 - ease((p - 0.68) / 0.12));
        var band = R * 0.85 + 70;
        if (alpha > 0.01) {
          // a tight grid, bent the way a sheet bends when something pushes up
          // through it (after Peter Kogler): the lines pile up into pleats at
          // the edge, ripple outwards in waves, and turn a little around it
          var step = W < 600 ? 13 : 16, sample = 6;
          var A = W < 600 ? 3 : 4.5, lam = W < 600 ? 9 : 12, T = 0.45;
          // the sheet makes room for the opening: every point moves out just
          // enough (d' = √(d² + r²)), so the part of the grid that was where the
          // shape now is gets gathered into tight lines wrapped round its edge;
          // far away the sheet is untouched. On top: a turn that changes side to
          // side, and small pleats travelling outwards.
          var warp = function (x, y) {
            var dx = x - cx, dy = y - cy, d = Math.hypot(dx, dy) || 0.001, th = Math.atan2(dy, dx);
            var rb = R * edge(th);
            var nd = Math.sqrt(d * d + rb * rb);
            var e = nd - rb, near = (rb * rb) / (d * d + rb * rb);
            nd += A * Math.sin(e / lam - p * 14 + th * 2) * Math.exp(-e / band);
            var nth = th + T * near * Math.sin(3 * th + p * 4 + e / (lam * 5));
            return [cx + Math.cos(nth) * nd, cy + Math.sin(nth) * nd];
          };
          var line = function (pts, gold) {
            ctx.beginPath();
            for (var n = 0; n < pts.length; n++) { var q = warp(pts[n][0], pts[n][1]); n ? ctx.lineTo(q[0], q[1]) : ctx.moveTo(q[0], q[1]); }
            ctx.strokeStyle = gold ? 'rgba(' + GOLD + ',' + (0.75 * alpha).toFixed(3) + ')' : 'rgba(13, 33, 54,' + (0.34 * alpha).toFixed(3) + ')';
            ctx.lineWidth = gold ? 0.9 : 0.6;
            ctx.stroke();
          };
          // only the part of the sheet the shape can reach
          var reach = R * 1.3 + band * 1.25;
          var X0 = Math.max(-step, cx - reach), X1 = Math.min(W + step, cx + reach);
          var Y0 = Math.max(-step, cy - reach), Y1 = Math.min(H + step, cy + reach);
          var gx = cx - Math.ceil((cx - X0) / step) * step;
          for (var x = gx; x <= X1; x += step) {
            var pts = [];
            for (var y = Y0; y <= Y1; y += sample) pts.push([x, y]);
            line(pts, Math.round((x - cx) / step) % 8 === 0);
          }
          var gy = cy - Math.ceil((cy - Y0) / step) * step;
          for (var yy = gy; yy <= Y1; yy += step) {
            var pts2 = [];
            for (var xx = X0; xx <= X1; xx += sample) pts2.push([xx, yy]);
            line(pts2, Math.round((yy - cy) / step) % 8 === 0);
          }
          // the grid is only where the shape is pressing: strong at its edge,
          // fading out across a band that widens as it grows; beyond it the
          // page is still flat
          var fall = ctx.createRadialGradient(cx, cy, Math.max(0, R * 0.7), cx, cy, R * 1.05 + band);
          fall.addColorStop(0, 'rgba(0,0,0,1)');
          fall.addColorStop(0.45, 'rgba(0,0,0,0.75)');
          fall.addColorStop(1, 'rgba(0,0,0,0)');
          ctx.globalCompositeOperation = 'destination-in';
          ctx.fillStyle = fall;
          ctx.fillRect(0, 0, W, H);
        }
        ctx.restore();

        // the outline drawn twice, like a pen going round it, and the desert
        // inside it, settling as it opens
        if (p >= open) win.style.clipPath = 'none';
        else win.style.clipPath = 'polygon(' + pts3.map(function (q) { return q[0].toFixed(1) + 'px ' + q[1].toFixed(1) + 'px'; }).join(',') + ')';
        if (p < open && p > 0.005) {
          var ra = 1 - ease((p - 0.6) / 0.18);
          [[0, 'rgba(' + GOLD + ',' + (0.85 * ra).toFixed(3) + ')', 1.2], [7, 'rgba(13, 33, 54,' + (0.35 * ra).toFixed(3) + ')', 0.8]].forEach(function (o) {
            ctx.beginPath();
            pts3.forEach(function (q, n) {
              var dx = q[0] - cx, dy = q[1] - cy, d = Math.hypot(dx, dy) || 1;
              var X = q[0] + (dx / d) * o[0], Y = q[1] + (dy / d) * o[0];
              n ? ctx.lineTo(X, Y) : ctx.moveTo(X, Y);
            });
            ctx.closePath(); ctx.strokeStyle = o[1]; ctx.lineWidth = o[2]; ctx.stroke();
          });
        }
        var kk = ease((p - 0.05) / 0.75);
        img.style.transformOrigin = '50% 100%';
        img.style.transform = 'scale(' + (1.25 - 0.25 * kk).toFixed(4) + ')';
        layer.classList.toggle('is-open', p >= open);
      },

      braid: function (sec, p) {
        var svg = sec.querySelector('.bw-braid'), paths = svg.querySelectorAll('.bw-lines path');
        var stopsG = svg.querySelector('.bw-stops');
        var Hs = sec.offsetHeight, key = Hs + 'x' + innerWidth;
        if (svg.dataset.key !== key) {
          svg.dataset.key = key;
          var narrow = innerWidth <= 760, w = narrow ? 30 : 170, cx = w / 2, A = narrow ? 8 : 38;
          svg.setAttribute('viewBox', '0 0 ' + w + ' ' + Hs);
          svg.style.width = w + 'px';
          // the stops, each a little off the middle, in height and to the side,
          // the way they would fall drawn by hand
          var JY = [-0.16, 0.12, -0.06, 0.18, -0.1], JX = [-0.3, 0.35, -0.15, 0.25, -0.2];
          var stops = [[cx, 0]];
          [].forEach.call(sec.querySelectorAll('.bw-item'), function (it, n) {
            var y = narrow ? it.offsetTop + 46 + JY[n % 5] * 40 : it.offsetTop + it.offsetHeight * (0.5 + JY[n % 5]);
            stops.push([cx + JX[n % 5] * A * (narrow ? 0.6 : 1), y]);
          });
          stops.push([cx, Hs]);
          var hand = function (y, n) { return 1.1 * Math.sin(y * 0.037 + n * 1.9) + 0.6 * Math.sin(y * 0.11 + n * 4.3) + 0.35 * Math.sin(y * 0.29 + n); };
          // the knot: a trefoil each thread goes round once as it reaches a
          // stop. It takes scroll to tie (KNOT px of "time"), and the threads
          // come in one after another (LAG), so you see the knot being made.
          var KNOT = narrow ? 80 : 130, LAG = narrow ? 18 : 28, sc = narrow ? 2.2 : 3.4;
          var built = [];
          for (var n = 0; n < 3; n++) {
            var ph = [0, 2.1, 4.2][n], pts = [], tm = [], shift = 0, sk = 1;
            for (var y = 0; y <= Hs; y += 5) {
              var k = 0; while (k < stops.length - 2 && y > stops[k + 1][1]) k++;
              // passing a stop: tie the knot there before going on
              if (sk < stops.length - 1 && y >= stops[sk][1]) {
                var s0 = stops[sk], turn = (sk - 1) * 0.9;
                shift += LAG * n;
                for (var q = 0; q <= 72; q++) {
                  var tt = (q / 72) * Math.PI * 2;
                  var kx = Math.sin(tt) + 2 * Math.sin(2 * tt), ky = Math.cos(tt) - 2 * Math.cos(2 * tt);
                  var rx = kx * Math.cos(turn) - ky * Math.sin(turn), ry = kx * Math.sin(turn) + ky * Math.cos(turn);
                  pts.push([s0[0] + rx * sc + n * 0.6, s0[1] + ry * sc * 0.9 - n * 0.4]);
                  tm.push(s0[1] + shift + (q / 72) * KNOT);
                }
                shift += KNOT + LAG * (2 - n);
                sk++;
              }
              var a = stops[k], b = stops[k + 1], u = (y - a[1]) / (b[1] - a[1] || 1);
              var amp = A * (0.75 + 0.5 * Math.abs(Math.sin(k * 2.7 + n)));
              var turns = 0.8 + 0.5 * Math.abs(Math.sin(k * 1.3 + n * 0.7));
              pts.push([lerp(a[0], b[0], u) + amp * Math.sin(Math.PI * u) * Math.sin(u * Math.PI * 2 * turns + ph) + hand(y, n), y]);
              tm.push(y + shift);
            }
            var d = '', len = [0];
            for (var m = 0; m < pts.length; m++) {
              d += (m ? 'L' : 'M') + pts[m][0].toFixed(1) + ' ' + pts[m][1].toFixed(1);
              if (m) len.push(len[m - 1] + Math.hypot(pts[m][0] - pts[m - 1][0], pts[m][1] - pts[m - 1][1]));
            }
            built.push({ d: d, tm: tm, len: len });
          }
          svg._end = Math.max.apply(null, built.map(function (bb) { return bb.tm[bb.tm.length - 1]; }));
          // each thread twice: the line, and a fainter second pass beside it
          for (var n3 = 0; n3 < 3; n3++) {
            [paths[n3 * 2], paths[n3 * 2 + 1]].forEach(function (el, ghost) {
              el.setAttribute('d', built[n3].d);
              if (ghost) el.setAttribute('transform', 'translate(' + (0.9 - n3 * 0.5) + ' 1.5)');
              el._tm = built[n3].tm; el._len = built[n3].len;
              var total = el._len[el._len.length - 1];
              el.style.strokeDasharray = total + ' ' + (total + 10);
            });
          }
          stopsG.innerHTML = '';
        }
        // how far along its own "time" each thread has got, and how much of it
        // is drawn by then
        var T = p * svg._end;
        for (var n2 = 0; n2 < paths.length; n2++) {
          var el = paths[n2], tm = el._tm, L = el._len, lo = 0, hi = tm.length - 1;
          if (T >= tm[hi]) { el.style.strokeDashoffset = 0; continue; }
          while (hi - lo > 1) { var mid = (lo + hi) >> 1; tm[mid] <= T ? (lo = mid) : (hi = mid); }
          var f = tm[hi] > tm[lo] ? (T - tm[lo]) / (tm[hi] - tm[lo]) : 0;
          var drawn = T <= tm[0] ? 0 : L[lo] + (L[hi] - L[lo]) * f;
          el.style.strokeDashoffset = (L[L.length - 1] - drawn).toFixed(1);
        }
      },

      mars: function (sec, p) {
        var stage = sec.firstElementChild, A = sec.querySelector('.mars-a');
        var a = sec.dataset.a.split(' ').map(Number);
        var W = stage.clientWidth, H = stage.clientHeight;
        var cA = Math.max(W / a[0], H / a[1]), AW = a[0] * cA, AH = a[1] * cA;
        var ox = Math.min(0, Math.max(W - AW, W * 0.5 - a[2] * AW));
        var oy = Math.min(0, Math.max(H - AH, H * 0.36 - a[3] * AH));
        var L0x = ox + a[2] * AW, L0y = oy + a[3] * AH;
        // a gentle step closer: the building stays in view, the flower a little larger
        var Send = W < 700 ? 1.22 : 1.32;
        var z = ease(p);
        var S = Math.exp(Math.log(Send) * z);
        var Lx = lerp(L0x, W * 0.5, z), Ly = L0y;
        A.style.width = AW + 'px'; A.style.height = AH + 'px';
        A.style.transform = 'translate(' + (Lx - a[2] * AW * S).toFixed(1) + 'px,' + (Ly - a[3] * AH * S).toFixed(1) + 'px) scale(' + S.toFixed(4) + ')';
      },
    };

    var on = new Set(), ticking = false;
    function update() {
      ticking = false;
      var vh = innerHeight;
      on.forEach(function (sec) {
        var p = progress(sec, sec.getBoundingClientRect(), vh);
        sec.style.setProperty('--p', p.toFixed(4));
        if (draw[sec.dataset.scrolly]) draw[sec.dataset.scrolly](sec, p);
      });
    }
    function ask() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }

    if (still) {
      var fin = function () {
        secs.forEach(function (sec) {
          sec.style.setProperty('--p', '1');
          if (draw[sec.dataset.scrolly]) draw[sec.dataset.scrolly](sec, 1);
        });
      };
      fin(); addEventListener('resize', fin);
      return;
    }

    document.documentElement.classList.add('scrolly');
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        e.isIntersecting ? on.add(e.target) : on.delete(e.target);
        // fetch a waiting group's pictures as soon as it is near, and draw again when they land
        if (e.isIntersecting && e.target.hasAttribute('data-wait')) {
          [].forEach.call(e.target.querySelectorAll('img'), function (im) {
            im.loading = 'eager';
            if (!im.complete) im.addEventListener('load', ask, { once: true });
          });
        }
      });
      ask();
    }, { rootMargin: '25% 0px' });
    secs.forEach(function (sec) { sec.style.setProperty('--p', '0'); on.add(sec); io.observe(sec); });
    update();
    on.clear();
    addEventListener('scroll', ask, { passive: true });
    addEventListener('resize', function () {
      var vh = innerHeight;
      secs.forEach(function (sec) {
        var p = progress(sec, sec.getBoundingClientRect(), vh);
        sec.style.setProperty('--p', p.toFixed(4));
        if (draw[sec.dataset.scrolly]) draw[sec.dataset.scrolly](sec, p);
      });
    });
  })();

  // The homepage loop: crossfade the frames, and only fetch a picture when it
  // is about to be needed. Pauses when the tab is hidden.
  (function () {
    var hero = document.querySelector('.hero[data-hold]');
    if (!hero) return;
    var slides = hero.querySelectorAll('.hs-slide');
    if (slides.length < 2) return;
    var hold = Number(hero.getAttribute('data-hold')) || 6200;
    var at = 0;
    var timer = null;

    function load(i) {
      var img = slides[(i + slides.length) % slides.length].querySelector('img.bg');
      if (img && img.dataset.src) {
        // the smaller copies, when the build added them, so a phone loads less
        if (img.dataset.srcset) {
          img.sizes = '(orientation: portrait) 100vh, 100vw'; // drawn as cover, full height
          img.srcset = img.dataset.srcset;
          delete img.dataset.srcset;
        }
        img.src = img.dataset.src;
        delete img.dataset.src;
      }
    }

    function go(i) {
      var next = (i + slides.length) % slides.length;
      slides[at].classList.remove('is-on');
      // dropping and re-adding the class restarts the drift from rest
      slides[next].offsetWidth;
      slides[next].classList.add('is-on');
      at = next;
      load(at + 1);
    }

    function start() {
      stop();
      timer = setInterval(function () { go(at + 1); }, hold);
    }
    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
    }

    load(1);
    start();
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stop();
      else start();
    });
  })();
</script>
</Base>
