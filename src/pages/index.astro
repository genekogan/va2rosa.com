---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import SpaceTime from '../components/SpaceTime.astro';
import { site } from '../data/site.js';
import { heroLoop, HOLD } from '../data/heroloop.js';
import { collections, essays } from '../data/collections.js';
import fs from 'node:fs';
import { topics } from '../data/topics.js';
import { nowRows } from '../data/cv.js';
import { press } from '../data/misc.js';

const livePress = press.filter((p) => p.live);

// a figure is only drawn if its file is actually on disk, so a picture still
// stuck in Drive cannot leave a broken image on the homepage
const figs = essays.research.figures.filter((f) =>
  fs.existsSync(new URL('../../public' + f.src, import.meta.url))
);
---

<Base
  bodyClass=""
  hasHero={true}
  description="Vanessa Rosa is a Brazilian time traveling artist. Murals become portals with projection mapping; hand-built ceramics become AI-powered characters. Little Martians, Mars College, and twenty years of public art, films and books."
>
  <!-- ENTRY ------------------------------------------------------------- -->
  <header class="hero" data-hold={HOLD}>
    <div class="hs">
      {heroLoop.map((f, i) => (
        <div class={`hs-slide mv-${f.move}${i === 0 ? ' is-on' : ''}`} data-i={i}>
          <img
            class="bg"
            src={i === 0 ? f.src : undefined}
            data-src={i === 0 ? undefined : f.src}
            alt={i === 0 ? f.alt : ''}
            style={`object-position:${f.pos}`}
            fetchpriority={i === 0 ? 'high' : undefined}
            aria-hidden={i === 0 ? undefined : 'true'}
            data-nozoom
          />
        </div>
      ))}
    </div>
    <div class="veil"></div>

    <div class="scrollcue" aria-hidden="true">Scroll ↓</div>
  </header>

  <div class="paper">
    <!-- WHO ------------------------------------------------------------- -->
    <section class="wrap intro" id="intro">
      <p class="greeting">{site.greeting}</p>
      <h1
        class="sec welcome"
        set:html={site.statementTitle
          .replace('\n', '<br>')
          .replace('time traveling', '<span class="tt">time traveling</span>')}
      />
      <p class="intro-what">
        {site.statement.map((line, i) => (<>{i > 0 && <>{' '}<br /></>}{line}</>))}
      </p>
    </section>

    <!-- TIMELINE -------------------------------------------------------- -->
    <section class="wrap" style="margin-top:70px" id="timeline">
      <Timeline />
    </section>

    <!-- phones only: the timeline as threads in a gravity well -->
    <section class="wrap st-wrap">
      <SpaceTime />
    </section>

    <!-- LITTLE MARTIANS: a portal opens in the page as you scroll past the
         timeline, its edge rippling like water, and lets you through ----- -->
    <section class="portal" id="door" data-scrolly="portal">
      <div class="portal-stage">
        <svg class="portal-rings" aria-hidden="true"><path /><path /><path /></svg>
        <div class="portal-win">
          <img src="/images/home/door-martians.webp" alt="The first Little Martian: a ceramic head lying on cracked desert ground." loading="lazy" data-full data-nozoom />
        </div>
        <div class="portal-veil"></div>
        <div class="portal-t">
          <div class="wrap">
            <h2 class="portal-logo"><img src="/images/home/lm-logo-white.webp" alt="Little Martians" loading="lazy" data-nozoom /></h2>
            <p>
              Imagining the future with my hands. I create a sci-fi world based on my ceramic
              characters. They’re Little Martians: a species descended from all of Earth’s life,
              tending life in extreme worlds and keeping our memory in the Imaginarium.
            </p>
            <p class="door-links">
              <a class="more" href="/threads/little-martians">The thread on this site ⇢</a>
              <a class="more" href={site.littleMartians} rel="noopener" target="_blank">Enter littlemartians.world ⇢</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- RESEARCH -------------------------------------------------------- -->
    <section class="wrap essay res-block" id="research-note">
      {figs[0] && (
        <img class="res-fig left" src={figs[0].src} alt={figs[0].alt} loading="lazy" />
      )}

      <div class="res-mid">
        <div class="kicker">{essays.research.kicker}</div>
        <p class="res-ask">{essays.research.highlight}</p>
        <div class="res-note">
          {essays.research.body.map((p) => <p>{p}</p>)}
        </div>
        {/* the names only; the one link below carries everyone through */}
        <p class="res-topics">
          {topics.map((t, i) => (
            <>
              {i > 0 && <span class="sep">·</span>}
              <span>{t.title}</span>
            </>
          ))}
        </p>
        <a class="more" style="margin-top:22px" href={essays.research.href}>{essays.research.linkText}</a>
      </div>

      {figs[1] && (
        <img class="res-fig right" src={figs[1].src} alt={figs[1].alt} loading="lazy" />
      )}
    </section>

    <!-- BODIES OF WORK: one path through time, each body of work a stop on
         it; the line draws itself as you go ------------------------------ -->
    <section class="wrap bw" id="work">
      <div class="kicker">The art</div>
      <h2 class="sec" style="margin:12px 0 10px">Many bodies of work</h2>
      <p class="bw-lede">
        Grouped by what they are made of and what they are for. They overlap, and each one fed
        the next.
      </p>

      <ol class="bw-list" data-scrolly="line">
        {collections.map((c, i) => (
          <li class="bw-item" data-scrolly="reveal">
            <a class="bw-img" href={c.items[0].href} tabindex="-1" aria-hidden="true">
              <img src={c.image} alt="" loading="lazy" data-nozoom />
            </a>
            <div class="bw-text">
              <span class="bw-n">{String(i + 1).padStart(2, '0')} · {c.span}</span>
              <h3>{c.title}</h3>
              <p>{c.blurb}</p>
              <ul class="bw-links">
                {c.items.map((it) => (
                  <li>
                    <a
                      href={it.href}
                      target={it.external ? '_blank' : undefined}
                      rel={it.external ? 'noopener' : undefined}
                    >
                      {it.label}<span>{it.years}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- IN PRINT (hidden until real quotes exist) ------------------------ -->
    {livePress.length > 0 && (
      <section class="wrap essay" id="press">
        <div class="kicker">In print</div>
        {livePress.map((q) => (
          <blockquote style="margin-top:26px; max-width:34em">
            <p class="hand" style="font-size:24px; line-height:1.3">“{q.quote}”</p>
            <cite class="kicker" style="font-style:normal">{q.outlet}, {q.year}</cite>
          </blockquote>
        ))}
      </section>
    )}

    <!-- MARS COLLEGE: the page opens in the shape of the Mars College flower,
         and you walk across the desert and up to the logo on the wall ---- -->
    <section
      class="mars-j"
      id="mars"
      data-scrolly="mars"
      data-a="2000 2713 0.53 0.305 0.145"
      data-b="1500 2000 0.52 0.41 1.12"
    >
      <div class="mars-stage">
        <div class="mars-clip">
          <img class="mars-a" src="/images/home/mars-approach.webp" alt="Chiba, the red mural building at Mars College, 2024, with the Mars College flower painted above the doors." loading="lazy" data-full data-nozoom />
          <img class="mars-b" src="/images/home/mars-logo.webp" alt="" loading="lazy" data-full data-nozoom />
        </div>
        <div class="mars-t">
          <div class="wrap">
            <div class="kicker">The desert</div>
            <h2>Mars College</h2>
            <p>
              Mars College is an annual off-grid pop-up college built literally from the ground up
              every winter in the California desert.
            </p>
            <p class="door-links">
              <a class="more" href="/mars-college">My thread on Mars College ⇢</a>
              <a class="more" href="https://mars.college" rel="noopener" target="_blank">mars.college ⇢</a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- NOW ------------------------------------------------------------- -->
    <section class="wrap essay" id="now">
      <div class="kicker">Current &amp; forthcoming</div>
      <h2 class="sec" style="margin:12px 0 0">Current &amp; Forthcoming</h2>
      <ul class="rows">
        {nowRows.map((r) => (
          <li>
            <span>{r.year}{r.monthLabel ? ` · ${r.monthLabel}` : ''}</span>
            <div>
              {r.href ? (
                <a
                  class="pr-t"
                  href={r.href}
                  target={r.href.startsWith('http') ? '_blank' : undefined}
                  rel={r.href.startsWith('http') ? 'noopener' : undefined}
                >
                  {r.title}
                </a>
              ) : (
                r.title
              )}
              {r.venue && <span style="opacity:.7">, {r.venue}</span>}
              {r.city && <span style="opacity:.7">, {r.city}</span>}
            </div>
          </li>
        ))}
      </ul>
      <p style="margin-top:34px"><a class="more" href="/info">Full record ⇢</a></p>
    </section>

    <!-- the end: seeds and plants from Verdelis’s Letter, growing up from
         the bottom of the page as you arrive -->
    <div class="garden" aria-hidden="true" data-scrolly="reveal">
      <img class="g g1" src="/images/home/garden-plants1.webp" alt="" loading="lazy" data-nozoom />
      <img class="g g2" src="/images/home/garden-seed2.webp" alt="" loading="lazy" data-nozoom />
      <img class="g g3" src="/images/home/garden-seed5.webp" alt="" loading="lazy" data-nozoom />
      <img class="g g4" src="/images/home/garden-flor2.webp" alt="" loading="lazy" data-nozoom />
      <img class="g g5" src="/images/home/garden-seed4.webp" alt="" loading="lazy" data-nozoom />
    </div>









  </div>

  <script is:inline>
  // Scroll-driven sections. Each gets --p, how far the reader has come
  // through it (0 → 1); the CSS reads it for fades and focus, and two drawings
  // read it here:
  //   portal — the Little Martians opening: an edge that ripples like water,
  //            rings spreading out from it, the desert turning into place;
  //   mars   — an opening in the shape of the Mars College flower, centred on
  //            the flower on the wall, then a walk up to it: one continuous
  //            zoom that hands over to a close photograph of the painting.
  // Reduced motion: every section is drawn once, finished, and stays still.
  (function () {
    var secs = [].slice.call(document.querySelectorAll('[data-scrolly]'));
    if (!secs.length) return;
    var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var cl = function (x) { return x < 0 ? 0 : x > 1 ? 1 : x; };
    var ease = function (x) { x = cl(x); return x * x * (3 - 2 * x); };
    var lerp = function (a, b, t) { return a + (b - a) * t; };

    function progress(sec, r, vh) {
      var t = sec.dataset.scrolly;
      if (t === 'reveal') return cl((vh - r.top) / (vh * 0.55));
      if (t === 'line') return cl((vh * 0.62 - r.top) / r.height);
      return cl((vh - r.top) / r.height); // from entering the screen to leaving the stage
    }

    // a closed outline around (cx, cy): radius R, bent by f(θ)
    function outline(cx, cy, R, f, n, svg) {
      var out = [];
      for (var k = 0; k < n; k++) {
        var a = (k / n) * Math.PI * 2, rr = R * f(a);
        var x = cx + Math.cos(a) * rr, y = cy + Math.sin(a) * rr;
        out.push(svg ? (k ? 'L' : 'M') + x.toFixed(1) + ' ' + y.toFixed(1) : x.toFixed(1) + 'px ' + y.toFixed(1) + 'px');
      }
      return svg ? out.join('') + 'Z' : 'polygon(' + out.join(',') + ')';
    }

    var draw = {
      portal: function (sec, p) {
        var stage = sec.firstElementChild, win = sec.querySelector('.portal-win');
        var img = win.querySelector('img'), rings = sec.querySelectorAll('.portal-rings path');
        var W = stage.clientWidth, H = stage.clientHeight, m = Math.min(W, H);
        var s = H / sec.offsetHeight;              // where the stage takes hold
        var open = 0.7;                            // fully open here
        var cx = W / 2, cy = H * 0.52;
        var cover = Math.hypot(W, H) * 0.62;
        var R = p < s ? lerp(10, m * 0.2, ease(p / s)) : lerp(m * 0.2, cover, Math.pow(cl((p - s) / (open - s)), 1.6));
        var q = cl((p - s) / (open - s));
        var amp = 0.11 * (1 - ease(q)) + 0.02 * (1 - q);
        var ph = p * 16;
        var f = function (o) {
          return function (a) {
            return 1 + amp * (0.55 * Math.sin(3 * a + ph + o) + 0.3 * Math.sin(5 * a - ph * 1.3 + o) + 0.15 * Math.sin(9 * a + ph * 2));
          };
        };
        win.style.clipPath = p >= open ? 'none' : outline(cx, cy, R, f(0), 90);
        // the scene settles as you go through: turned and too close, then still
        var k = ease((p - 0.12) / 0.62);
        img.style.transform = 'scale(' + (1.38 - 0.38 * k).toFixed(4) + ') rotate(' + ((1 - k) * -13).toFixed(2) + 'deg)';
        // three rings spreading out from the edge, gone once it is open
        var svg = sec.querySelector('.portal-rings');
        svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);
        for (var i = 0; i < rings.length; i++) {
          var drift = (p * 3 + i / rings.length) % 1;
          rings[i].setAttribute('d', outline(cx, cy, R * (1.08 + 0.55 * drift), f(i * 1.7), 72, true));
          rings[i].style.opacity = ((1 - drift) * 0.55 * (1 - q)).toFixed(3);
        }
      },

      mars: function (sec, p) {
        var stage = sec.firstElementChild, clip = sec.querySelector('.mars-clip');
        var A = sec.querySelector('.mars-a'), B = sec.querySelector('.mars-b');
        var a = sec.dataset.a.split(' ').map(Number), b = sec.dataset.b.split(' ').map(Number);
        var W = stage.clientWidth, H = stage.clientHeight;
        var s = H / sec.offsetHeight;
        // the approach photograph, covering the screen, the flower high in the frame
        var cA = Math.max(W / a[0], H / a[1]), AW = a[0] * cA, AH = a[1] * cA;
        var ox = Math.min(0, Math.max(W - AW, W * 0.5 - a[2] * AW));
        var oy = Math.min(0, Math.max(H - AH, H * 0.34 - a[3] * AH));
        var L0x = ox + a[2] * AW, L0y = oy + a[3] * AH;
        // the close photograph, covering the screen when the walk ends
        var cB = Math.max(W / b[0], H / b[1]) * 1.08, BW = b[0] * cB, BH = b[1] * cB;
        var Lex = W * 0.5, Ley = H * 0.42;
        var Send = (b[4] * BW) / (b[3] * AW);
        // the opening: a flower of eight petals, centred on the painted one
        var o = cl(p / (s + 0.1));
        var cover = Math.hypot(W, H) * 1.05;
        var R = lerp(0, cover, Math.pow(o, 1.35));
        var amp = 0.16 * (1 - ease(o)), rot = p * 2.2;
        clip.style.clipPath = o >= 1 ? 'none' : outline(L0x, L0y, R, function (t) { return 1 + amp * Math.cos(8 * t + rot); }, 120);
        // the walk: a steady zoom, the flower drifting to the middle
        var z = cl((p - (s + 0.04)) / (0.86 - (s + 0.04)));
        var S = Math.exp(Math.log(Send) * z);
        var e = ease(z), Lx = lerp(L0x, Lex, e), Ly = lerp(L0y, Ley, e);
        A.style.width = AW + 'px'; A.style.height = AH + 'px';
        A.style.transform = 'translate(' + (Lx - a[2] * AW * S).toFixed(1) + 'px,' + (Ly - a[3] * AH * S).toFixed(1) + 'px) scale(' + S.toFixed(4) + ')';
        var SB = (S * b[3] * AW) / (b[4] * BW);
        B.style.width = BW + 'px'; B.style.height = BH + 'px';
        B.style.transform = 'translate(' + (Lx - b[2] * BW * SB).toFixed(1) + 'px,' + (Ly - b[3] * BH * SB).toFixed(1) + 'px) scale(' + SB.toFixed(4) + ')';
        // the close photograph comes in as a soft circle around the flower, then fills
        // (a soft oval that fades out before the photograph's own edges, then,
        // once the photograph fills the screen, a solid layer that lets it all show)
        var fade = ease((z - 0.32) / 0.3);
        var inner = lerp(45, 80, ease((z - 0.4) / 0.4)).toFixed(1);
        var all = ease((z - 0.82) / 0.16).toFixed(3);
        var mask = 'radial-gradient(closest-side at ' + (b[2] * 100).toFixed(1) + '% ' + (b[3] * 100).toFixed(1) + '%, #000 ' + inner + '%, transparent 100%), ' +
          'linear-gradient(rgba(0,0,0,' + all + '), rgba(0,0,0,' + all + '))';
        B.style.webkitMaskImage = B.style.maskImage = mask;
        B.style.opacity = fade.toFixed(3);
      },
    };

    var on = new Set(), ticking = false;
    function update() {
      ticking = false;
      var vh = innerHeight;
      on.forEach(function (sec) {
        var p = progress(sec, sec.getBoundingClientRect(), vh);
        sec.style.setProperty('--p', p.toFixed(4));
        if (draw[sec.dataset.scrolly]) draw[sec.dataset.scrolly](sec, p);
      });
    }
    function ask() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }

    if (still) {
      secs.forEach(function (sec) {
        sec.style.setProperty('--p', '1');
        if (draw[sec.dataset.scrolly]) draw[sec.dataset.scrolly](sec, 1);
      });
      addEventListener('resize', function () {
        secs.forEach(function (sec) { if (draw[sec.dataset.scrolly]) draw[sec.dataset.scrolly](sec, 1); });
      });
      return;
    }

    document.documentElement.classList.add('scrolly');
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { e.isIntersecting ? on.add(e.target) : on.delete(e.target); });
      ask();
    }, { rootMargin: '25% 0px' });
    secs.forEach(function (sec) { sec.style.setProperty('--p', '0'); on.add(sec); io.observe(sec); });
    update();
    on.clear();
    addEventListener('scroll', ask, { passive: true });
    addEventListener('resize', ask);
  })();

  // The homepage loop: crossfade the frames, and only fetch a picture when it
  // is about to be needed. Pauses when the tab is hidden.
  (function () {
    var hero = document.querySelector('.hero[data-hold]');
    if (!hero) return;
    var slides = hero.querySelectorAll('.hs-slide');
    if (slides.length < 2) return;
    var hold = Number(hero.getAttribute('data-hold')) || 6200;
    var at = 0;
    var timer = null;

    function load(i) {
      var img = slides[(i + slides.length) % slides.length].querySelector('img.bg');
      if (img && img.dataset.src) {
        // the smaller copies, when the build added them, so a phone loads less
        if (img.dataset.srcset) {
          img.sizes = '(orientation: portrait) 100vh, 100vw'; // drawn as cover, full height
          img.srcset = img.dataset.srcset;
          delete img.dataset.srcset;
        }
        img.src = img.dataset.src;
        delete img.dataset.src;
      }
    }

    function go(i) {
      var next = (i + slides.length) % slides.length;
      slides[at].classList.remove('is-on');
      // dropping and re-adding the class restarts the drift from rest
      slides[next].offsetWidth;
      slides[next].classList.add('is-on');
      at = next;
      load(at + 1);
    }

    function start() {
      stop();
      timer = setInterval(function () { go(at + 1); }, hold);
    }
    function stop() {
      if (timer) clearInterval(timer);
      timer = null;
    }

    load(1);
    start();
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stop();
      else start();
    });
  })();
</script>
</Base>
