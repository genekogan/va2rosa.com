---
import Base from '../layouts/Base.astro';
import { books } from '../data/books.js';
import BookReader from '../components/BookReader.astro';
import Story from '../components/Story.astro';
---

<Base title={books.title} current="Art" description={books.lede} bodyClass="paper">
  <div class="projhero">
    <img src={books.hero} alt={books.heroAlt} fetchpriority="high" />
    <div class="t">
      <div class="kicker" style="color:#fff; opacity:.9">{books.kicker}</div>
      <h1>{books.title}</h1>
    </div>
  </div>

  <div class="wrap">
    <div class="meta">
      {books.meta.map(([k, v]) => (
        <div><div class="k">{k}</div>{v}</div>
      ))}
    </div>

    <div class="narrow" style="margin-top:52px">
      <p class="lede">{books.lede}</p>
    </div>

    {books.opening && <Story story={books.opening} />}

    <div style="margin-top:26px">
      {books.story.map((p, i) => (
        <>
          <div class="narrow"><p>{p}</p></div>
          {books.inline?.[i] && <div class="books-inline"><Story story={books.inline[i]} /></div>}
        </>
      ))}
    </div>

    <section class="wsec">
      <div class="kicker">Selection of my best books</div>
      <div class="bookset">
        {books.titles.map((b) => (
          <div class="bookentry">
            <article class="bookrow">
              {b.image ? (
                <img src={b.image} alt={b.imageAlt ?? ''} loading="lazy" />
              ) : (
                <div class="bookrow-gap" aria-hidden="true"></div>
              )}
              <div>
                <h3>{b.title}</h3>
                {b.year && <div class="bookrow-yr">{b.year}</div>}
                <p>{b.body}</p>
              </div>
            </article>
            {b.read && (
              <div class="bookread">
                {b.read.note && <p class="bookread-note">{b.read.note}</p>}
                <BookReader book={{ ...b.read, title: b.title }} />
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <p class="closing">{books.closing}</p>

    <p style="margin:44px 0 90px">
      {books.links.map((l) => (
        <a
          class="more"
          style="margin-right:22px"
          href={l.href}
          target={l.external ? '_blank' : undefined}
          rel={l.external ? 'noopener' : undefined}
        >
          {l.label} ⇢
        </a>
      ))}
      <a class="more" href="/art">All the art ⇢</a>
    </p>
  </div>
</Base>
