---
import Base from '../layouts/Base.astro';
import { site } from '../data/site.js';
import { byYear, cvTypes, typeLabel } from '../data/cv.js';
import { pressByYear, pressKinds } from '../data/press.js';

const portraits = [
  { src: '/images/me/me-01.webp', caption: 'Photo by Edu Monteiro, 2025', alt: 'Vanessa Rosa in a patterned dress, against a grey backdrop.' },
  { src: '/images/me/me-02.webp', caption: 'Photo by Renata Chebel, 2024', alt: 'Vanessa Rosa in the desert, holding ceramic heads in both hands, in black and white.' },
  { src: '/images/me/me-03.webp', caption: 'Photo by Ania Catherine, 2022', alt: 'Vanessa Rosa holding a small blue ceramic head.' },
  { src: '/images/me/me-04.webp', caption: 'With a Little Martian', alt: 'Vanessa Rosa in profile, face to face with a dark glazed ceramic head.' },
  { src: '/images/me/me-05.webp', caption: 'Photo by Renata Chebel, 2024', alt: 'Vanessa Rosa by the sea, holding a ceramic head to her face, in black and white.' },
  { src: '/images/me/me-06.webp', caption: 'Photo by Edu Monteiro, 2025', alt: 'Vanessa Rosa looking over her shoulder, in black and white.' },
  { src: '/images/me/me-07.webp', caption: 'Painting in New York, 2017', alt: 'Vanessa Rosa kneeling on a large blue tile painting laid on a wooden floor.' },
];
---

<Base
  title="Info"
  current="Info"
  bodyClass=""
  description="Biography, full curriculum and press record of Vanessa Rosa, Brazilian visual artist and art historian: exhibitions, film festivals, awards, talks, teaching, residencies and publications since 2009."
>
  <!-- Photographs of Vanessa, one at a time, beside the bio. -->
  <div class="about">
   <div class="about-inner">
    <div class="about-art">
      <div class="slides about-slides" data-slides>
        <div class="sl-stage">
          <button class="sl-nav sl-prev" type="button" aria-label="Previous">‹</button>
          <div class="sl-track">
            {portraits.map((im, i) => (
              <figure class="sl-item" data-i={i} hidden={i !== 0 ? true : undefined}>
                <img src={im.src} alt={im.alt} loading={i < 1 ? 'eager' : 'lazy'} />
                <figcaption>{im.caption}</figcaption>
              </figure>
            ))}
          </div>
          <button class="sl-nav sl-next" type="button" aria-label="Next">›</button>
        </div>
        <div class="sl-bar">
          <span class="sl-count">1 / {portraits.length}</span>
        </div>
        <div class="sl-grid" hidden></div>
      </div>
    </div>

    <div class="about-text">
      {site.bioLong.map((p) => <p>{p}</p>)}
      <p style="margin-top:20px">
        <a class="more" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
   </div>
  </div>

  <div class="paper">
    <!-- The talk, before the record: easier to watch than to read. -->
    <section class="wrap" style="padding-top:70px">
      <div class="kicker">Watch first</div>
      <h2 class="sec" style="margin:12px 0 6px">Little Martians: building an AI powered sci-fi world</h2>
      <p style="font-size:14px; color:var(--ink-2); max-width:40em">
        A walk through the work, from the clay to the films.
      </p>

      <div class="infovid">
        <div class="film-play" data-yt="TG16nfIx66o" role="button" tabindex="0"
             aria-label="Play: Little Martians, building an AI powered sci-fi world">
          <img src="/images/films/TG16nfIx66o.webp" alt="" data-nozoom />
          <span class="film-btn" aria-hidden="true">▶</span>
        </div>
        <p style="margin-top:14px">
          <a class="more" href="https://www.youtube.com/watch?v=TG16nfIx66o" target="_blank" rel="noopener">
            Watch on YouTube ⇢
          </a>
        </p>
      </div>
    </section>

    <section class="wrap" style="padding-top:70px; padding-bottom:90px">
      <div class="kicker">The record</div>
      <h2 class="sec" style="margin:12px 0 6px">Curriculum</h2>
      <p style="font-size:14px; color:var(--ink-2); max-width:40em">
        Opens on a selection. Switch to Everything for the full record: exhibitions, solo shows,
        films, awards, talks and teaching, residencies, public art, publishing, press, education
        and affiliations, newest first.
      </p>

      <div class="filters" role="group" aria-label="Filter the record">
        {cvTypes.map((t, i) => (
          <button type="button" data-filter={t.key} aria-pressed={t.key === 'selected' ? 'true' : 'false'}>
            {t.label}
          </button>
        ))}
      </div>

      <div id="cvlist">
        {byYear.map((r) => (
          <div class="cvline" data-type={r.type} data-featured={r.featured ? "yes" : "no"}>
            <b>{r.year}</b>
            <div>
              {r.href ? (
                <a class="pr-t" href={r.href} target="_blank" rel="noopener">{r.title}</a>
              ) : (
                r.title
              )}
              {(r.venue || r.city) && (
                <div class="t">
                  {[r.venue, r.city].filter(Boolean).join(', ')}
                  {r.href2 && (
                    <>
                      {' · '}
                      <a class="pr-t" href={r.href2} target="_blank" rel="noopener">
                        {r.href2Label ?? 'More'}
                      </a>
                    </>
                  )}
                </div>
              )}
            </div>
            <div class="ty">{typeLabel[r.type]}</div>
          </div>
        ))}
      </div>



      <!-- PRESS ------------------------------------------------------------
           Same machinery as the curriculum above, its own set of tabs. -->
      <div class="rule" style="margin:56px 0 34px" id="press"></div>
      <div class="kicker">The coverage</div>
      <h2 class="sec" style="margin:12px 0 6px">Press &amp; media</h2>
      <p style="font-size:14px; color:var(--ink-2); max-width:40em">
        Opens on a selection. The tabs sort the rest by where it ran: Brazilian media,
        television, online, the reporting on Mars College, written interviews, podcasts
        and documentary series. Every line links out.
      </p>

      <div class="filters" role="group" aria-label="Filter the press">
        {pressKinds.map((k) => (
          <button
            type="button"
            data-pfilter={k.key}
            aria-pressed={k.key === 'selected' ? 'true' : 'false'}
          >
            {k.label}
          </button>
        ))}
      </div>

      <div id="presslist">
        {pressByYear.map((p) => (
          <div
            class="cvline"
            data-kinds={p.kinds.join(' ')}
            data-featured={p.featured ? 'yes' : 'no'}
          >
            <b>{p.year}</b>
            <div>
              <a class="pr-t" href={p.href} target="_blank" rel="noopener">{p.title}</a>
              <div class="t">
                {[
                  p.outlet,
                  p.note,
                  p.by === 'her' ? 'Written by Vanessa Rosa.' : null,
                ]
                  .filter(Boolean)
                  .map((x) => x.replace(/\.$/, ''))
                  .join('. ') + '.'}
              </div>
            </div>
            <div class="ty">
              {[p.lang ? `in ${p.lang}` : null, p.clipping ? 'clipping' : null]
                .filter(Boolean)
                .join(', ')}
            </div>
          </div>
        ))}
      </div>

      <div class="rule" style="margin:50px 0 30px"></div>
      <div class="kicker">Downloads</div>
      {site.cvPdf && (
        <p style="margin-top:14px">
          <a class="more" href={site.cvPdf} download>{site.cvLabel} ⇢</a>
        </p>
      )}
      <p style="margin-top:18px; font-size:12.5px; color:var(--ink-3)">
        ORCID <a class="ul" href={site.orcid} rel="noopener me" target="_blank">0000-0003-2583-7985</a>
      </p>
    </section>
  </div>

  <script is:inline>
    (function () {
      // One filter for two lists: the curriculum matches on a single type,
      // the press on any of several kinds.
      function wire(attr, listId, matches) {
        var buttons = document.querySelectorAll('[' + attr + ']');
        var rows = document.querySelectorAll('#' + listId + ' .cvline');
        function apply(key) {
          buttons.forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.getAttribute(attr) === key));
          });
          rows.forEach(function (row) {
            var show =
              key === 'all' ||
              (key === 'selected' ? row.dataset.featured === 'yes' : matches(row, key));
            row.style.display = show ? '' : 'none';
          });
        }
        buttons.forEach(function (b) {
          b.addEventListener('click', function () {
            apply(b.getAttribute(attr));
          });
        });
        // Everything is in the HTML; the selection is what you land on.
        apply('selected');
      }

      wire('data-filter', 'cvlist', function (row, key) {
        return row.dataset.type === key;
      });
      wire('data-pfilter', 'presslist', function (row, key) {
        return (' ' + row.dataset.kinds + ' ').indexOf(' ' + key + ' ') > -1;
      });
    })();

    // The player arrives only when someone asks for it.
    (function () {
      function play(box) {
        var f = document.createElement('iframe');
        f.src = 'https://www.youtube-nocookie.com/embed/' + box.getAttribute('data-yt') + '?autoplay=1&rel=0';
        f.title = 'Little Martians: building an AI powered sci-fi world';
        f.allow = 'autoplay; fullscreen; picture-in-picture';
        f.setAttribute('allowfullscreen', '');
        box.replaceChildren(f);
        box.classList.add('is-live');
        box.removeAttribute('role');
        box.removeAttribute('tabindex');
      }
      document.querySelectorAll('.infovid .film-play').forEach(function (box) {
        box.addEventListener('click', function () { play(box); });
        box.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); play(box); }
        });
      });
    })();
  </script>
</Base>

<script is:inline>
  // The photographs: one at a time, arrows to move.
  document.querySelectorAll('.about-slides').forEach(function (box) {
    var items = box.querySelectorAll('.sl-item');
    var count = box.querySelector('.sl-count');
    var at = 0;
    function show(i) {
      at = (i + items.length) % items.length;
      items.forEach(function (el, k) {
        el.hidden = k !== at;
        if (k === at) el.querySelector('img').loading = 'eager';
      });
      count.textContent = at + 1 + ' / ' + items.length;
    }
    box.querySelector('.sl-prev').addEventListener('click', function () { show(at - 1); });
    box.querySelector('.sl-next').addEventListener('click', function () { show(at + 1); });
  });
</script>
