---
// The long texts from the fiction page, one page each. Every block says who
// wrote it: Vanessa, Vanessa writing for the model (the prompt), the model,
// or — where the source document does not say — nobody, in so many words.
import Base from '../../layouts/Base.astro';
import BookReader from '../../components/BookReader.astro';
import { fictionPages } from '../../data/fiction.js';
import { memories as m, duet, verdelisStories as vs } from '../../data/fiction-texts.js';

export function getStaticPaths() {
  return Object.keys(fictionPages).map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const page = fictionPages[slug];

// Stage directions and shot notes — (…) and […] — are set apart from the text.
const parts = (s) =>
  s.split(/(\([^)]*\)|\[[^\]]*\])/g).filter(Boolean).map((t) => ({
    dir: /^[([]/.test(t),
    t,
  }));

// In the story engine, short unpunctuated lines are headings.
const isHead = (p) => p.length < 64 && !/[.:,;!?…"”]$/.test(p) && !p.startsWith('• ');
---

<Base title={`${page.title} · Fiction writing`} current="Art" description={page.context[0]} bodyClass="paper">
  <div class="wrap fx-page">
    <p class="fx-back"><a href="/fiction-writing">← Fiction writing</a></p>
    <div class="kicker" style="margin-top:34px">{page.kicker}</div>
    <h1 class="fx-title">{page.title}</h1>

    <div class="narrow fx-context">
      {page.context.map((p) => <p>{p}</p>)}
    </div>

    {page.film && (
      <div class="vid fx-film">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${page.film.youtube}?rel=0`}
          title={page.film.title}
          loading="lazy"
          allow="fullscreen; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    )}

    {/* ================================================================== */}
    {slug === 'dear-human' && (
      <>
        <section class="fx-part">
          <h2 class="fx-part-h">The song</h2>
          <div class="fx-block fx-mine fx-lyrics">
            <div class="fx-label">Final version · reworked with ChatGPT and Suno, 2024</div>
            {page.song.map((st) => <p>{st.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>)}
          </div>
        </section>

        <section class="fx-part">
          <h2 class="fx-part-h">The first version, with no AI</h2>
          <div class="fx-block fx-mine fx-lyrics fx-draft">
            <div class="fx-label">Written by Vanessa Rosa</div>
            {page.firstVersion.map((st) => <p>{st.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p>)}
          </div>
        </section>

        <section class="fx-part">
          <h2 class="fx-part-h">How it changed</h2>
          <div class="narrow">
            {page.process.map((p) => <p>{p}</p>)}
          </div>
        </section>
      </>
    )}

    {/* ================================================================== */}
    {slug === 'memories-of-mars' && (
      <>
        <ul class="fx-legend" aria-label="Key">
          <li><i class="fx-sw fx-mine"></i>Written by Vanessa Rosa</li>
          <li><i class="fx-sw fx-prompt"></i>Prompt: written by Vanessa for GPT-3</li>
          <li><i class="fx-sw fx-ai"></i>Generated by GPT-3</li>
          <li><i class="fx-sw fx-unmarked"></i>Not marked in the document</li>
        </ul>

        <section class="fx-part">
          <h2 class="fx-part-h">I. The opening</h2>
          <div class="fx-block fx-mine">
            <div class="fx-label">Written by Vanessa Rosa · a script for a video, with the shots in brackets</div>
            <h3 class="fx-block-h">{parts(m.title).map((x) => x.dir ? <span class="fx-dir">{x.t}</span> : x.t)}</h3>
            {m.script.map((p) => <p>{parts(p).map((x) => x.dir ? <span class="fx-dir">{x.t}</span> : x.t)}</p>)}
          </div>
          <p class="fx-note">Working note in the document: “{m.note}”</p>
        </section>

        <section class="fx-part">
          <h2 class="fx-part-h">II. Memories</h2>
          <div class="fx-block fx-prompt">
            <div class="fx-label">Prompt · written by Vanessa for GPT-3</div>
            <p class="fx-prompt-line">{m.promptLine}</p>
            {m.promptChars.map((c) => (
              <div class="fx-char">
                <div class="fx-char-h">Character {c.n} · {c.name}{c.tag && <span class="fx-dir"> — {c.tag}</span>}</div>
                <p>{c.text}</p>
              </div>
            ))}
          </div>

          <div class="fx-block fx-ai">
            <div class="fx-label">Generated by GPT-3 · selected by Vanessa, numbered as in the document</div>
            {m.aiChars.map((c) => (
              <div class="fx-char">
                <div class="fx-char-h">
                  Character {c.n}{c.name ? ` · ${c.name}` : ''}
                  {!c.name && <span class="fx-dir"> — the model wrote this memory where the name should go</span>}
                </div>
                <p>{c.text}</p>
              </div>
            ))}
          </div>
        </section>

        <section class="fx-part">
          <h2 class="fx-part-h">III. Martian Shakespeare</h2>
          <div class="fx-block fx-unmarked">
            <div class="fx-label">Not marked in the document · it borrows Hamlet’s soliloquy</div>
            <p>{m.shakespeare}</p>
          </div>
          <p class="fx-note">
            More on this game in <a class="ul" href="https://littlemartians.substack.com/p/ai-shakespeare" target="_blank" rel="noopener">AI Shakespeare</a>, on the Little Martians Substack.
          </p>
        </section>

        <section class="fx-part">
          <h2 class="fx-part-h">IV. Theories of where the Martians came from</h2>
          <div class="fx-block fx-prompt">
            <div class="fx-label">Prompt · the four numbered theories</div>
            {m.theoriesNumbered.map((t) => (
              <div class="fx-char">
                <div class="fx-char-h">Theory {t.n}</div>
                <p>{t.text}</p>
              </div>
            ))}
          </div>
          <div class="fx-block fx-ai">
            <div class="fx-label">Generated by GPT-3 · the unnumbered theories that follow</div>
            {m.theoriesGenerated.map((p) => <p>{p}</p>)}
          </div>
        </section>
      </>
    )}

    {/* ================================================================== */}
    {slug === 'verdelis-and-mycos' && (
      <>
        <ul class="fx-legend" aria-label="Key">
          <li><i class="fx-sw fx-mine"></i>Written by Vanessa Rosa with ChatGPT, 2024</li>
          <li><span class="fx-dir">(stage directions)</span></li>
        </ul>
        <div class="fx-script">
          {duet.turns.map((t, i) => (
            <>
              {t.after && !duet.turns[i - 1]?.after && <h2 class="fx-part-h" style="margin-top:44px">After scene</h2>}
              <div class="fx-turn">
                <div class={`fx-who fx-who-${t.who.toLowerCase()}`}>{t.who}</div>
                <div class="fx-lines">
                  {t.lines.map((l) =>
                    l === '' ? <div class="fx-gap"></div>
                      : <p>{parts(l).map((x) => x.dir ? <span class="fx-dir">{x.t}</span> : x.t)}</p>
                  )}
                </div>
              </div>
            </>
          ))}
          {duet.afterIntro.length > 0 && duet.afterIntro.map((l) => <p class="fx-dir">{l}</p>)}
        </div>
      </>
    )}

    {/* ================================================================== */}
    {slug === 'verdelis-stories' && (
      <>
        <section class="fx-part">
          <h2 class="fx-part-h">I. The story engine</h2>
          <div class="fx-block fx-prompt fx-engine">
            <div class="fx-label">System prompt · written by Vanessa Rosa</div>
            {vs.engine.map((p) =>
              p.startsWith('• ') ? <p class="fx-bullet">{p.slice(2)}</p>
              : isHead(p) ? <h3 class="fx-engine-h">{p}</h3>
              : <p>{p}</p>
            )}
          </div>
        </section>

        <section class="fx-part">
          <h2 class="fx-part-h">II. The stories</h2>
          {vs.groups.map((g) => (
            <div class="fx-triad">
              <h3 class="fx-triad-h">{g.title}</h3>
              {g.stories.map((s) => (
                <article class="fx-story">
                  <div class="fx-story-n">{s.n}</div>
                  <div>
                    <h4 class="fx-story-h">{s.title}</h4>
                    {s.paras.map((p, i) => (
                      <p class={i === 0 ? 'fx-open' : i === s.paras.length - 1 ? 'fx-close' : undefined}>{p}</p>
                    ))}
                  </div>
                </article>
              ))}
            </div>
          ))}
        </section>

      </>
    )}

    {/* ================================================================== */}
    {slug === 'outer-membrane' && (
      <>
        
      <section class="fx-part fx-membrane" style="margin-top:34px">
        <h3 class="fx-mem-h">{page.membrane.letters.title}</h3>
        <div class="narrow">
          {page.membrane.letters.body.map((p) => <p>{p}</p>)}
        </div>
        <div class="fx-letters">
          {page.membrane.letters.images.map((im) => (
            <figure>
              <img src={im.src} alt={`${im.title}: a letter from Verdelis as an etched page, made with AI on Eden.`} loading="lazy" />
              <figcaption>{im.title}</figcaption>
            </figure>
          ))}
        </div>

        <h3 class="fx-mem-h">{page.membrane.codex.title}</h3>
        <div class="narrow">
          {page.membrane.codex.body.map((p) => <p>{p}</p>)}
        </div>
        <BookReader book={page.membrane.codex.read} />

        <h3 class="fx-mem-h">{page.membrane.design.title}</h3>
        <div class="narrow">
          {page.membrane.design.body.map((p) => <p>{p}</p>)}
        </div>
        <p class="fx-note">Images made with AI on Eden, 9 February 2026, for The Outer Membrane.</p>
      </section>
    
      </>
    )}

    <p style="margin:64px 0 90px"><a class="more" href="/fiction-writing">All the fiction ⇢</a></p>
  </div>
</Base>
