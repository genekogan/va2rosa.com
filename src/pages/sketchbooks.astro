---
// Drawings. Vanessa's own two lines from the original page, and then the work.
// No invented framing: the drawings do the talking.
import Base from '../layouts/Base.astro';

const drawings = Array.from({ length: 17 }, (_, i) =>
  `/images/sk/dr-${String(i + 1).padStart(2, '0')}.webp`
);
---

<Base
  title="Drawings"
  current="Art"
  bodyClass="paper"
  description="Drawings by Vanessa Rosa: watercolour and ink sketches made on the streets and in life model sessions."
>
  <section class="wrap" style="padding-top:70px">
    <div class="kicker">Drawings</div>
    <h1 class="sec" style="margin:12px 0 20px">What I love most is to draw wherever I am</h1>
    <p class="lede">
      Here some sketches done mostly on the streets or life model sessions.
    </p>
  </section>

  <section class="wrap" style="padding-top:34px; padding-bottom:70px">
    <div class="wgrid tall">
      {drawings.map((src) => (
        <figure>
          <img src={src} alt="A drawing by Vanessa Rosa." loading="lazy" />
        </figure>
      ))}
    </div>

    <p style="margin-top:50px">
      <a class="more" href="/art">All the art ⇢</a>
    </p>
  </section>
</Base>
