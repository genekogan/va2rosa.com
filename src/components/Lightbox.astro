---
// Click any picture on the site to open it large. Click outside it, press Esc
// or use the close button to come back. Arrow keys and the side buttons move
// through the other pictures in the same block.
//
// Nothing is marked up per-image: the script picks up every <img> that is not
// navigation furniture and not already wrapped in a link.
---

<div class="lightbox" id="lightbox" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Enlarged picture">
  <button class="lb-close" type="button" aria-label="Close">✕</button>
  <button class="lb-nav lb-prev" type="button" aria-label="Previous picture">‹</button>
  <button class="lb-nav lb-next" type="button" aria-label="Next picture">›</button>
  <div class="lb-stage">
    <img class="lb-img" alt="" />
  </div>
  <div class="lb-bar">
    <span class="lb-cap"></span>
    <span class="lb-count"></span>
  </div>
</div>

<script is:inline>
  (function () {
    var box = document.getElementById('lightbox');
    if (!box) return;
    var stage = box.querySelector('.lb-stage');
    var img = box.querySelector('.lb-img');
    var cap = box.querySelector('.lb-cap');
    var count = box.querySelector('.lb-count');
    var group = [];
    var at = 0;
    var lastFocus = null;

    // Anything decorative or already doing something else on click is left alone.
    var SKIP = '.nav img, .lightbox img, .motto, [data-nozoom]';

    function zoomable(el) {
      return (
        el &&
        el.tagName === 'IMG' &&
        !el.matches(SKIP) &&
        !el.closest('a') &&
        !el.closest('[data-nozoom]')
      );
    }

    // The pictures around it: same gallery, same section, or the whole page.
    // A slide gallery holds each picture twice, once in the slider and once in
    // the hidden "show all" grid, so anything not on screen is left out.
    function siblings(el) {
      // In a slide gallery the whole set travels together, even though only
      // one slide is on screen. Pick the copy the click came from.
      var slides = el.closest('.slides');
      if (slides) {
        var sel = el.closest('.sl-grid') ? '.sl-grid img' : '.sl-item img';
        return Array.prototype.filter.call(slides.querySelectorAll(sel), zoomable);
      }
      var scope =
        el.closest('.wgrid, .ph-images, .slides, .showcards, .lib-grid, .pf-figs') ||
        el.closest('section') ||
        document.body;
      var all = Array.prototype.filter.call(scope.querySelectorAll('img'), zoomable);
      var shown = all.filter(function (x) {
        return x === el || x.offsetParent !== null;
      });
      return shown.length ? shown : all;
    }

    function captionOf(el) {
      var fig = el.closest('figure');
      var fc = fig && fig.querySelector('figcaption');
      return (fc && fc.textContent.trim()) || el.getAttribute('alt') || '';
    }

    function show(i) {
      at = (i + group.length) % group.length;
      var el = group[at];
      img.classList.remove('is-zoomed');
      stage.scrollTop = 0;
      stage.scrollLeft = 0;
      img.src = el.currentSrc || el.src;
      img.alt = el.getAttribute('alt') || '';
      cap.textContent = captionOf(el);
      count.textContent = group.length > 1 ? at + 1 + ' / ' + group.length : '';
      box.querySelector('.lb-prev').hidden = group.length < 2;
      box.querySelector('.lb-next').hidden = group.length < 2;
    }

    function open(el) {
      lastFocus = document.activeElement;
      group = siblings(el);
      if (group.indexOf(el) < 0) group = [el];
      show(group.indexOf(el));
      box.hidden = false;
      box.setAttribute('aria-hidden', 'false');
      document.body.classList.add('lb-open');
      box.querySelector('.lb-close').focus();
    }

    function close() {
      box.hidden = true;
      box.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('lb-open');
      img.removeAttribute('src');
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    document.addEventListener('click', function (e) {
      var el = e.target;
      if (zoomable(el)) {
        e.preventDefault();
        open(el);
      }
    });

    box.addEventListener('click', function (e) {
      if (e.target === box || e.target === stage) return close();
      if (e.target.closest('.lb-close')) return close();
      if (e.target.closest('.lb-prev')) return show(at - 1);
      if (e.target.closest('.lb-next')) return show(at + 1);
      // A click on the picture itself goes in closer, and back out again.
      if (e.target === img) img.classList.toggle('is-zoomed');
    });

    document.addEventListener('keydown', function (e) {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(at - 1);
      else if (e.key === 'ArrowRight') show(at + 1);
    });
  })();
</script>
