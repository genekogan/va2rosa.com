---
// The timeline as a drawing rather than a chart: a gravity well of rings,
// 2009 deep inside and "now" at the rim. Each period is a thread that spirals
// out from its first year to its last; the ones still going run on to the rim
// and fade. On phones the well opens upward; on wider screens it lies on its
// side and opens to the right, towards now. It turns slowly and can be
// dragged. A tap on a node or a name lights up that thread; a second tap on
// the same one opens its page.
//
// Wider up, the spiral sits over a plain timeline on the same year scale: one
// thin bar per period, directly under where its thread runs in the well, so
// the drawing and the dates read together. Hovering a bar lights its thread.
import { threads, timelineExtra, linkFor } from '../data/threads.js';

const stateLabel = { ended: 'ended', transformed: 'became the next thing', ongoing: 'ongoing' };
const rows = [...threads, ...timelineExtra].map((t) => ({
  n: t.number ?? '',
  title: t.title,
  years: t.years,
  start: t.start,
  end: t.end ?? null,
  state: t.state,
  status: stateLabel[t.state],
  carrier: t.carrier ?? '',
  href: t.href ?? linkFor(t) ?? '',
  underlay: !!t.underlay,
}));

// the year scale the strip under the spiral shares with it (as fractions)
const FIRST = 2009, LAST = 2027, SPAN = LAST - FIRST;
const f = (y) => ((y - FIRST) / SPAN).toFixed(4);
const ticks = [2009, 2012, 2015, 2018, 2021, 2024];
---

<section class="spacetime" aria-label="The work over time, drawn as threads in a gravity well">
  <div class="kicker">Timeline</div>
  <canvas class="st-canvas" data-rows={JSON.stringify(rows)} aria-hidden="true"></canvas>

  <!-- wider screens: the same periods as a timeline, under the well -->
  <div class="st-strip">
    {ticks.map((y) => <i class="st-grid" style={`--a:${f(y)}`} aria-hidden="true"></i>)}
    {rows.map((r, i) => (
      <button
        type="button"
        data-i={i}
        class={`st-row s-${r.state}${r.end === null ? ' going' : ''}${r.underlay ? ' under' : ''}`}
        style={`--a:${f(r.start)}; --b:${f(r.end ?? LAST)}`}
      >
        <span class="st-bar"><span>{r.n ? `${r.n} · ` : ''}{r.title}</span><em>{r.years}</em></span>
      </button>
    ))}
    <div class="st-axis" aria-hidden="true">
      {ticks.map((y) => <span style={`--a:${f(y)}`}>{y}</span>)}
      <span style={`--a:${f(2026)}`}>now</span>
    </div>
  </div>

  <div class="st-info" aria-live="polite">
    <p class="st-info-meta"></p>
    <a class="st-info-t" href="#"></a>
    <p class="st-info-c"></p>
  </div>

  <ol class="st-list" aria-describedby="st-hint">
    {rows.map((r, i) => (
      <li>
        <button type="button" data-i={i}>
          <span class="st-n">{r.n || '·'}</span>{r.title}
        </button>
      </li>
    ))}
  </ol>
  <p class="st-hint" id="st-hint">Once to see it, twice to open it.</p>
</section>

<script is:inline>
  (function () {
    var box = document.querySelector('.spacetime');
    if (!box) return;
    var cv = box.querySelector('.st-canvas');
    var rows = JSON.parse(cv.getAttribute('data-rows'));
    var ctx = cv.getContext('2d');
    var FIRST = 2009, LAST = 2027, SPAN = LAST - FIRST;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var W = 0, H = 0, R = 0, cx = 0, cy = 0, dpr = 1, wide = false, x0 = 0, L = 0;
    var strip = box.querySelector('.st-strip');
    function size() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = cv.clientWidth;
      wide = W > 600;
      H = wide ? Math.round(Math.min(360, Math.max(250, W * 0.27))) : Math.round(W * 1.02);
      box.classList.toggle('is-wide', wide);
      cv.style.height = H + 'px';
      cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (wide) {
        // lying on its side: the rim on the right, the deep end on the left;
        // the strip underneath takes the same left edge and length
        R = H * 0.44; cy = H * 0.5; x0 = 46; L = W - x0 - R * 0.42 - 34;
        strip.style.setProperty('--x0', x0 + 'px');
        strip.style.setProperty('--L', L + 'px');
      } else {
        R = W * 0.46; cx = W / 2; cy = H * 0.40;
      }
    }

    // year -> radius and depth: the early years sink into the middle of the well
    function rad(y) { return R * (0.1 + 0.9 * (y - FIRST) / SPAN); }
    function depth(y) { var t = 1 - (y - FIRST) / SPAN; return R * 0.95 * t * t; }
    // lying down, how far along the well a year sits (the early years spread
    // out a little more, the way they sink deeper in the upright drawing)
    function along(y) { return x0 + L * (y - FIRST) / SPAN; }

    var theta = 0.6;
    function project(y, a) {
      var r = rad(y), u = r * Math.cos(a + theta), z = r * Math.sin(a + theta);
      var persp = 1 / (1 + z / (R * 5));               // the far side a little smaller
      if (wide) return { x: along(y) + z * 0.42 * persp, y: cy + u * persp, z: z };
      return { x: cx + u * persp, y: cy + (z * 0.42 + depth(y)) * persp, z: z };
    }

    // each thread gets its own bearing, and spirals as the years pass
    var TWIST = 0.16;
    rows.forEach(function (r, i) {
      r.a0 = (i / rows.length) * Math.PI * 2;
      r.stop = r.end === null ? LAST : r.end + 0.4;
    });
    function bearing(r, y) { return r.a0 + TWIST * (y - r.start); }

    var sel = 0, hov = -1, nodes = [];
    var BLUE = '28, 74, 134', GREY = '109, 130, 153';

    function draw() {
      ctx.clearRect(0, 0, W, H);

      // the well itself: rings every three years, and spokes
      ctx.lineWidth = 1;
      for (var y = FIRST; y <= LAST; y += 3) {
        ctx.beginPath();
        for (var k = 0; k <= 96; k++) {
          var p = project(y, (k / 96) * Math.PI * 2);
          k ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y);
        }
        ctx.strokeStyle = 'rgba(' + BLUE + ',' + (y === LAST ? 0.22 : 0.10) + ')';
        ctx.stroke();
      }
      for (var s = 0; s < 16; s++) {
        ctx.beginPath();
        for (var yy = FIRST; yy <= LAST; yy += 0.5) {
          var q = project(yy, (s / 16) * Math.PI * 2);
          yy === FIRST ? ctx.moveTo(q.x, q.y) : ctx.lineTo(q.x, q.y);
        }
        ctx.strokeStyle = 'rgba(' + BLUE + ',0.07)';
        ctx.stroke();
      }

      // the years, written on the rim and in the well
      ctx.font = '10px ui-sans-serif, system-ui, sans-serif';
      ctx.fillStyle = 'rgba(' + BLUE + ',0.55)';
      ctx.textAlign = 'center';
      if (wide) {
        // the years are written on the strip below; here, the lit thread is
        // tied down to its bar by a faint plumb line from where it begins
        var lit = hov >= 0 ? hov : sel, rl = rows[lit];
        if (rl) {
          var p0 = project(rl.start, bearing(rl, rl.start));
          ctx.beginPath(); ctx.setLineDash([2, 4]);
          ctx.moveTo(p0.x, p0.y); ctx.lineTo(along(rl.start), H);
          ctx.strokeStyle = 'rgba(' + BLUE + ',0.35)'; ctx.lineWidth = 1; ctx.stroke();
          ctx.setLineDash([]);
        }
      } else {
        ctx.fillText('2009', cx, cy + depth(FIRST) + 16);
        // "now" sits on the right-hand edge of the rim, clear of the threads
        var rim = project(LAST, -theta);
        ctx.textAlign = 'right';
        ctx.fillText('now', rim.x - 2, rim.y - 7);
      }

      // the threads
      nodes = [];
      rows.forEach(function (r, i) {
        var on = i === sel || i === hov;
        var col = r.underlay ? GREY : BLUE;
        var pts = [];
        for (var y = r.start; y <= r.stop; y += 0.25) pts.push(project(y, bearing(r, y)));
        for (var j = 1; j < pts.length; j++) {
          var f = j / pts.length;
          var fade = r.end === null ? Math.max(0, 1 - Math.max(0, f - 0.7) / 0.3) : 1;
          var base = on ? 0.95 : 0.42;
          ctx.beginPath();
          ctx.moveTo(pts[j - 1].x, pts[j - 1].y); ctx.lineTo(pts[j].x, pts[j].y);
          ctx.strokeStyle = 'rgba(' + col + ',' + (base * fade).toFixed(3) + ')';
          ctx.lineWidth = on ? 3.2 : (r.state === 'ended' ? 1.2 : 1.8);
          if (r.state === 'transformed') ctx.setLineDash([4, 3]); else ctx.setLineDash([]);
          ctx.stroke();
        }
        ctx.setLineDash([]);
        var a = pts[0];
        ctx.beginPath(); ctx.arc(a.x, a.y, on ? 5 : 3.4, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(' + col + ',' + (on ? 1 : 0.8) + ')'; ctx.fill();
        if (r.end !== null) {
          var b = pts[pts.length - 1];
          ctx.beginPath(); ctx.arc(b.x, b.y, on ? 4.5 : 3, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(' + col + ',' + (on ? 1 : 0.6) + ')'; ctx.lineWidth = 1.3; ctx.stroke();
        }
        ctx.fillStyle = 'rgba(' + col + ',' + (on ? 1 : 0.75) + ')';
        ctx.font = (on ? '600 ' : '') + '10px ui-sans-serif, system-ui, sans-serif';
        ctx.textAlign = 'left';
        ctx.fillText(r.n || '·', a.x + 7, a.y - 5);
        nodes.push({ i: i, x: a.x, y: a.y });
      });
    }

    var info = box.querySelector('.st-info');
    var btns = box.querySelectorAll('.st-list button, .st-row');
    function select(i) {
      sel = i;
      var r = rows[i];
      info.querySelector('.st-info-meta').textContent = (r.n ? r.n + ' · ' : '') + r.years + ' · ' + r.status;
      var t = info.querySelector('.st-info-t');
      t.textContent = r.title;
      if (r.href) { t.href = r.href; t.removeAttribute('aria-disabled'); } else { t.removeAttribute('href'); }
      info.querySelector('.st-info-c').textContent = r.carrier;
      btns.forEach(function (b) { b.classList.toggle('is-on', +b.getAttribute('data-i') === i); });
      draw();
    }
    // once to light it up, a second time on the same one to open its page
    function pick(i) {
      if (i === sel && rows[i].href) { window.location.href = rows[i].href; return; }
      select(i);
    }
    btns.forEach(function (b) {
      b.addEventListener('click', function () { pick(+b.getAttribute('data-i')); });
    });
    // hovering a bar lights its thread in the well
    box.querySelectorAll('.st-row').forEach(function (b) {
      b.addEventListener('mouseenter', function () { hov = +b.getAttribute('data-i'); draw(); });
      b.addEventListener('mouseleave', function () { hov = -1; draw(); });
    });

    // drag to turn the well; a tap near a node picks that thread
    var down = null, moved = 0;
    cv.addEventListener('pointerdown', function (e) { down = e.clientX; moved = 0; });
    cv.addEventListener('pointermove', function (e) {
      if (down === null) return;
      var dx = e.clientX - down; down = e.clientX; moved += Math.abs(dx);
      theta += dx * 0.012; draw();
    });
    cv.addEventListener('pointerup', function (e) {
      if (moved < 6) {
        var rect = cv.getBoundingClientRect(), x = e.clientX - rect.left, y = e.clientY - rect.top;
        var best = null, bd = 26;
        nodes.forEach(function (n) { var d = Math.hypot(n.x - x, n.y - y); if (d < bd) { bd = d; best = n; } });
        if (best) pick(best.i);
      }
      down = null;
    });
    cv.addEventListener('pointercancel', function () { down = null; });

    // a slow turn, only while the drawing is on screen
    var visible = false, last = 0;
    function tick(t) {
      if (visible && down === null && !reduce) {
        theta += Math.min(t - last, 50) * 0.00012;
        draw();
      }
      last = t;
      requestAnimationFrame(tick);
    }
    new IntersectionObserver(function (es) { visible = es[0].isIntersecting; }).observe(cv);

    // start on Little Martians, the work going on now
    var start = rows.findIndex(function (r) { return r.title === 'Little Martians'; });
    size(); select(start < 0 ? 0 : start);
    window.addEventListener('resize', function () { size(); draw(); });
    requestAnimationFrame(tick);
  })();
</script>
