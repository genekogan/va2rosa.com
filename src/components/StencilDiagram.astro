---
// How the Silk Roads stencils work, in four drawings: a tile pattern; the same
// pattern as a laser-cut stencil, its islands held by bridges; the stencil
// distorted and cut at several scales; and the pieces sprayed side by side into
// a corridor that converges on one point. Drawn here in SVG, so it is sharp at
// any size and costs no download. `compact` hides the step texts (for the card
// on the Silk Roads page).
const { compact = false } = Astro.props;

// one tile, in a 0–100 box: border, quatrefoil, centre, corner quarters
const motif = `
  <rect x="3" y="3" width="94" height="94" />
  <circle cx="50" cy="31" r="17" /><circle cx="69" cy="50" r="17" />
  <circle cx="50" cy="69" r="17" /><circle cx="31" cy="50" r="17" />
  <circle cx="50" cy="50" r="8" />
  <path d="M3 19 A16 16 0 0 0 19 3 M81 3 A16 16 0 0 0 97 19 M97 81 A16 16 0 0 0 81 97 M19 97 A16 16 0 0 0 3 81" />
  <path d="M50 3 L56 9 L50 15 L44 9 Z M97 50 L91 56 L85 50 L91 44 Z M50 97 L44 91 L50 85 L56 91 Z M3 50 L9 44 L15 50 L9 56 Z" />`;

// the same tile cut as a stencil: a plate with holes, and bridges (the strips
// left uncut) that keep the inner shapes from falling out. Colours are set on
// the shapes themselves: page CSS does not reach inside a <use> copy.
const stencil = `
  <rect x="0" y="0" width="100" height="100" fill="#1c4a86" />
  <g fill="#eef3f7">
    <circle cx="50" cy="31" r="15" /><circle cx="69" cy="50" r="15" />
    <circle cx="50" cy="69" r="15" /><circle cx="31" cy="50" r="15" />
    <path d="M5 19 A14 14 0 0 0 19 5 L5 5 Z M81 5 A14 14 0 0 0 95 19 L95 5 Z M95 81 A14 14 0 0 0 81 95 L95 95 Z M19 95 A14 14 0 0 0 5 81 L5 95 Z" />
    <path d="M50 4 L55 9 L50 14 L45 9 Z M96 50 L91 55 L86 50 L91 45 Z M50 96 L45 91 L50 86 L55 91 Z M4 50 L9 45 L14 50 L9 55 Z" />
  </g>
  <circle cx="50" cy="50" r="10" fill="#1c4a86" />
  <g fill="#1c4a86">
    <rect x="47.5" y="10" width="5" height="80" /><rect x="10" y="47.5" width="80" height="5" />
    <rect x="47.5" y="10" width="5" height="80" transform="rotate(45 50 50)" />
    <rect x="47.5" y="10" width="5" height="80" transform="rotate(-45 50 50)" />
  </g>`;

// place a unit tile (0–1) on a quadrilateral, closely enough for a drawing:
// an affine map from three of its corners
const put = (id, p0, p1, p3) => {
  const a = (p1[0] - p0[0]) / 100, b = (p1[1] - p0[1]) / 100;
  const c = (p3[0] - p0[0]) / 100, d = (p3[1] - p0[1]) / 100;
  return `<use href="#${id}" width="100" height="100" transform="matrix(${a.toFixed(4)} ${b.toFixed(4)} ${c.toFixed(4)} ${d.toFixed(4)} ${p0[0].toFixed(2)} ${p0[1].toFixed(2)})" />`;
};
const lerp = (a, b, t) => a + (b - a) * t;

// the corridor: an outer square and an inner one, the walls between them laid
// with tiles that shrink towards the vanishing point
const O = [8, 8, 192, 192], I = [78, 78, 122, 122], N = 4, M = 3;
const depth = (i) => 1 - Math.pow(0.62, i * 1.35);   // foreshortened spacing, 0 → ~1
const tiles = [];
for (let i = 0; i < N; i++) {
  const t0 = depth(i) / depth(N), t1 = depth(i + 1) / depth(N);
  // the four walls at depth t0 and t1: [x0, y0, x1, y1] of the frame there
  const f = (t) => [lerp(O[0], I[0], t), lerp(O[1], I[1], t), lerp(O[2], I[2], t), lerp(O[3], I[3], t)];
  const a = f(t0), b = f(t1);
  for (let j = 0; j < M; j++) {
    const u0 = j / M, u1 = (j + 1) / M;
    // left wall: x from a[0] to b[0], y along the wall
    tiles.push(put('st-stencil-t', [a[0], lerp(a[1], a[3], u0)], [b[0], lerp(b[1], b[3], u0)], [a[0], lerp(a[1], a[3], u1)]));
    // right wall
    tiles.push(put('st-stencil-t', [a[2], lerp(a[1], a[3], u0)], [b[2], lerp(b[1], b[3], u0)], [a[2], lerp(a[1], a[3], u1)]));
    // ceiling
    tiles.push(put('st-stencil-t', [lerp(a[0], a[2], u0), a[1]], [lerp(b[0], b[2], u0), b[1]], [lerp(a[0], a[2], u1), a[1]]));
    // floor
    tiles.push(put('st-stencil-t', [lerp(a[0], a[2], u0), a[3]], [lerp(b[0], b[2], u0), b[3]], [lerp(a[0], a[2], u1), a[3]]));
  }
}
// the back wall, flat
for (let r = 0; r < 2; r++) for (let c = 0; c < 2; c++) {
  const s = (I[2] - I[0]) / 2;
  tiles.push(put('st-stencil-t', [I[0] + c * s, I[1] + r * s], [I[0] + (c + 1) * s, I[1] + r * s], [I[0] + c * s, I[1] + (r + 1) * s]));
}

const steps = [
  { n: '1', t: 'Pattern', d: 'A pattern from a tile, a textile or a building, redrawn as lines.' },
  { n: '2', t: 'Stencil', d: 'The shapes become holes for the laser to cut. Bridges, the strips left uncut, hold the islands in place.' },
  { n: '3', t: 'Distorted, at several scales', d: 'The same stencil is bent into the shapes a perspective needs, and cut in different sizes.' },
  { n: '4', t: 'Modules', d: 'Sprayed one beside the other, the pieces build walls, floors and arches that meet in one point.' },
];
---

<figure class={compact ? 'stdiag compact' : 'stdiag'}>
  <svg width="0" height="0" class="stdiag-defs" aria-hidden="true">
    <defs>
      <symbol id="st-motif-t" viewBox="0 0 100 100" overflow="visible"><g fill="none" stroke="#1c4a86" stroke-width="1.6" stroke-linejoin="round" set:html={motif} /></symbol>
      <symbol id="st-stencil-t" viewBox="0 0 100 100" overflow="visible"><g set:html={stencil} /></symbol>
    </defs>
  </svg>

  <ol class="stdiag-steps">
    <li>
      <svg viewBox="-10 -10 220 220" role="img" aria-label="A tile pattern drawn as lines">
        <use href="#st-motif-t" x="20" y="20" width="160" height="160" />
      </svg>
      <div class="stdiag-t"><span>{steps[0].n}</span> {steps[0].t}</div>
      {!compact && <p>{steps[0].d}</p>}
    </li>
    <li>
      <svg viewBox="-10 -10 220 220" role="img" aria-label="The same pattern as a stencil, with bridges">
        <use href="#st-stencil-t" x="20" y="20" width="160" height="160" />
        <g class="callout">
          <path d="M100 52 C 140 30, 170 30, 190 10" /><text x="196" y="12">bridge</text>
        </g>
      </svg>
      <div class="stdiag-t"><span>{steps[1].n}</span> {steps[1].t}</div>
      {!compact && <p>{steps[1].d}</p>}
    </li>
    <li>
      <svg viewBox="-10 -10 220 220" role="img" aria-label="The stencil distorted and cut at three scales">
        <g set:html={
          put('st-stencil-t', [10, 70], [110, 40], [10, 150]) +
          put('st-stencil-t', [120, 30], [190, 50], [125, 90]) +
          put('st-stencil-t', [130, 120], [170, 112], [128, 160]) +
          put('st-stencil-t', [70, 160], [100, 170], [62, 190])
        } />
      </svg>
      <div class="stdiag-t"><span>{steps[2].n}</span> {steps[2].t}</div>
      {!compact && <p>{steps[2].d}</p>}
    </li>
    <li>
      <svg viewBox="-10 -10 220 220" role="img" aria-label="The pieces sprayed into a corridor in one-point perspective">
        <g set:html={tiles.join('')} />
        <rect x="8" y="8" width="184" height="184" class="frame" />
      </svg>
      <div class="stdiag-t"><span>{steps[3].n}</span> {steps[3].t}</div>
      {!compact && <p>{steps[3].d}</p>}
    </li>
  </ol>
</figure>
