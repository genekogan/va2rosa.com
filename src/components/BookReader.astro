---
// Leaf through a book the way you would hold it: two pages open at once, and
// turning a page lifts the leaf on your right and lays it over on the left,
// pivoting on the spine. Pages are WebP files made by scripts/render-book.py,
// so nothing but images ships — no PDF reader, no library.
//
// Two kinds of PDF come in, and both end up as the same list of openings:
//   spread: true   the file is a booklet exported as spreads. Its first page is
//                  the cover; every page after it is two pages side by side,
//                  and the reader cuts each one at the spine.
//   spread: false  one PDF page is one book page. The cover stands alone on
//                  the right, then 2–3, 4–5 … exactly as they face in print.
//
// book = { slug, pages: [pdf page numbers], spread, aspect (one page, w/h), title }
const { book } = Astro.props;
const { slug, pages, spread = false, aspect = 0.75, title } = book;

const url = (n) => `/images/books/${slug}/p-${String(n).padStart(3, '0')}.webp`;

// An opening is [left, right]; each side is a page, or null for no page.
// `part` says which bit of the image is the page: all of it, or one half.
const openings = [];
const [cover, ...rest] = pages;
openings.push([null, { src: url(cover), part: 'full' }]);
if (spread) {
  for (const n of rest) {
    openings.push([{ src: url(n), part: 'l' }, { src: url(n), part: 'r' }]);
  }
} else {
  for (let i = 0; i < rest.length; i += 2) {
    openings.push([
      { src: url(rest[i]), part: 'full' },
      rest[i + 1] ? { src: url(rest[i + 1]), part: 'full' } : null,
    ]);
  }
}

const style = (p) => (p ? `background-image:url('${p.src}')` : '');
const first = openings[0];
---

<div
  class="bk"
  data-bk={JSON.stringify(openings)}
  style={`--page:${aspect}`}
  role="group"
  aria-roledescription="book"
  aria-label={title ? `${title}, a few pages to leaf through` : 'A book to leaf through'}
  tabindex="0"
>
  <div class="bk-stage">
    <div class="bk-book at-cover">
      <div class="bk-page bk-l empty" data-side="l"></div>
      <div class="bk-page bk-r" data-side="r" data-part={first[1].part} style={style(first[1])}></div>

      <div class="bk-leaf" aria-hidden="true">
        <div class="bk-page bk-face bk-front"></div>
        <div class="bk-page bk-face bk-back"></div>
      </div>
    </div>

    <button class="bk-hit bk-hit-prev" type="button" aria-label="Previous pages" disabled></button>
    <button class="bk-hit bk-hit-next" type="button" aria-label="Next pages"></button>
  </div>

  <div class="bk-bar">
    <button class="bk-btn" type="button" data-prev disabled aria-label="Previous pages">‹</button>
    <span class="bk-count" aria-live="polite">1 / {openings.length}</span>
    <button class="bk-btn" type="button" data-next aria-label="Next pages">›</button>
  </div>
</div>

<script is:inline>
  (function () {
    var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('.bk').forEach(function (bk) {
      if (bk.dataset.wired) return;
      bk.dataset.wired = '1';

      var O = JSON.parse(bk.dataset.bk);
      var book = bk.querySelector('.bk-book');
      var L = bk.querySelector('.bk-l');
      var R = bk.querySelector('.bk-r');
      var leaf = bk.querySelector('.bk-leaf');
      var front = bk.querySelector('.bk-front');
      var back = bk.querySelector('.bk-back');
      var count = bk.querySelector('.bk-count');
      var prevs = bk.querySelectorAll('[data-prev], .bk-hit-prev');
      var nexts = bk.querySelectorAll('[data-next], .bk-hit-next');
      var at = 0;
      var busy = false;

      function paint(el, p) {
        if (!p) {
          el.classList.add('empty');
          el.style.backgroundImage = '';
          el.removeAttribute('data-part');
          return;
        }
        el.classList.remove('empty');
        el.style.backgroundImage = "url('" + p.src + "')";
        el.dataset.part = p.part;
      }

      // A closed book sits centred on its cover; an open one centres on the
      // spine. The last opening may have only a left page, and slides the
      // other way.
      function shift(i) {
        book.classList.toggle('at-cover', !O[i][0]);
        book.classList.toggle('at-end', !O[i][1]);
      }

      function preload(i) {
        if (i < 0 || i >= O.length) return;
        O[i].forEach(function (p) { if (p) new Image().src = p.src; });
      }

      function controls() {
        count.textContent = at + 1 + ' / ' + O.length;
        prevs.forEach(function (b) { b.disabled = at === 0; });
        nexts.forEach(function (b) { b.disabled = at === O.length - 1; });
      }

      function settle(i) {
        at = i;
        paint(L, O[i][0]);
        paint(R, O[i][1]);
        leaf.className = 'bk-leaf';
        busy = false;
        controls();
        preload(i + 1);
        preload(i - 1);
      }

      function go(to) {
        if (busy || to < 0 || to >= O.length || to === at) return;
        var cur = O[at], nxt = O[to];

        if (reduced) { shift(to); settle(to); return; }
        busy = true;

        if (to > at) {
          // The right-hand leaf lifts off the page underneath (the next
          // right page) and lands on the left, showing its other side.
          paint(L, cur[0]);
          paint(R, nxt[1]);
          paint(front, cur[1]);
          paint(back, nxt[0]);
          leaf.className = 'bk-leaf fwd';
        } else {
          paint(L, nxt[0]);
          paint(R, cur[1]);
          paint(front, cur[0]);
          paint(back, nxt[1]);
          leaf.className = 'bk-leaf back';
        }
        shift(to);

        var done = false;
        function end() { if (done) return; done = true; settle(to); }
        leaf.addEventListener('animationend', end, { once: true });
        setTimeout(end, 1100);                 // in case the event never fires
      }

      prevs.forEach(function (b) { b.addEventListener('click', function () { go(at - 1); }); });
      nexts.forEach(function (b) { b.addEventListener('click', function () { go(at + 1); }); });

      bk.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(at + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(at - 1); }
      });

      var x0 = null, y0 = null;
      bk.addEventListener('touchstart', function (e) {
        x0 = e.touches[0].clientX; y0 = e.touches[0].clientY;
      }, { passive: true });
      bk.addEventListener('touchend', function (e) {
        if (x0 === null) return;
        var dx = e.changedTouches[0].clientX - x0;
        var dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(at + (dx < 0 ? 1 : -1));
        x0 = y0 = null;
      }, { passive: true });

      preload(1);
    });
  })();
</script>
