---
// The seven movements, repeated at the foot of every thread page.
// Every entry point re-tells the story. Nothing is a dead end.
import { threads, linkFor } from '../data/threads.js';
const { current = '' } = Astro.props;
---

<div class="rule" style="margin:70px 0 34px"></div>
<div class="kicker">The seven movements</div>
<p class="spine-foot">
  {threads.map((t, i) => (
    <>
      {i > 0 && <span aria-hidden="true"> · </span>}
      {linkFor(t)
        ? <a href={linkFor(t)} class={t.slug === current ? 'cur' : undefined}>{t.number} {t.title}</a>
        : <span>{t.number} {t.title}</span>}
    </>
  ))}
</p>
